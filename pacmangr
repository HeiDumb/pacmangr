#!/usr/bin/env python3
"""
pacmangr: a terminal package manager for mixed Linux systems.

It autodetects package managers already present on the host, including distro
managers, language package managers, Flatpak, and local AppImages. Search/list
operations run inside curses when a manager exposes parseable output. Install,
remove, update, and version-list operations run without replacing the native
package managers underneath.

This file is now a thin compatibility shim: the implementation lives in the
``pacmangr_core`` package next to this script.
"""

from __future__ import annotations

import sys
from pathlib import Path

_SCRIPT_DIR = str(Path(__file__).resolve().parent)
if _SCRIPT_DIR not in sys.path:
    sys.path.insert(0, _SCRIPT_DIR)

from pacmangr_core import *  # noqa: E402,F403
import pacmangr_core as _core  # noqa: E402
from pacmangr_core import run_cli as _run_cli  # noqa: E402
from types import ModuleType as _ModuleType  # noqa: E402

__all__ = list(_core.__all__)

# Callers (GUI/tests) historically rebound globals such as GIT_SOURCE_ROOT on
# this module object.  Forward such writes into the package facade so every
# reader observes the new value.
_FORWARDED = frozenset(
    {"GIT_SOURCE_ROOT", "PIP_VENV_ROOT", "MANAGER_SPECS", "CACHE_DB_PATH"}
)


class _ShimModule(_ModuleType):
    def __getattr__(self, name: str):
        if name in _FORWARDED:
            return getattr(_core, name)
        raise AttributeError(f"module {self.__name__!r} has no attribute {name!r}")

    def __setattr__(self, name: str, value) -> None:
        if name in _FORWARDED:
            setattr(_core, name, value)
            return
        _ModuleType.__setattr__(self, name, value)


sys.modules[__name__].__class__ = _ShimModule
for _name in _FORWARDED:
    globals().pop(_name, None)


if __name__ == "__main__":
    _run_cli()
