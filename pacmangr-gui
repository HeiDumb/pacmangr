    def show_manager_status(self, _widget=None) -> None:
        lines = []
        for label, key in self.sources[1:]:
            if key == "appimage":
                lines.append(f"{label}\nLocal files in Applications folders")
                continue
            path = None
            if key in {"pacman", "yay", "paru", "flatpak", "apt", "snap", "git"}:
                attr = "apt_cache" if key == "apt" else key
                path = getattr(self.tools, attr, None)
            else:
                path = self.tools.extra_managers.get(key)
            lines.append(f"{label}\n{path or 'not detected'}")
        lines.append("\nNix note\nProfile and nix-env packages are managed when their CLI is detected; declarative system or Home Manager files are never rewritten behind your back.")
        self.show_text_dialog("Package manager status", "\n\n".join(lines))

    def show_cache_status(self, _widget=None) -> None:
        self.show_text_dialog("Local package cache", cache_summary(self.cache))

    def confirm_clear_cache(self, _widget=None) -> None:
        if not self.window:
            return
        dialog = Gtk.AlertDialog()
        dialog.set_message("Clear Pacmangr's local cache?")
        dialog.set_detail("Only cached search, installed-package, and version metadata is removed. No packages are changed.")
        dialog.set_buttons(["Cancel", "Clear cache"])
        dialog.set_cancel_button(0)
        dialog.set_default_button(1)

        def finished(alert: Gtk.AlertDialog, result) -> None:
            try:
                response = alert.choose_finish(result)
            except GLib.Error:
                return
            if response != 1:
                return
            removed = False
            for path in (self.cache.path, Path(f"{self.cache.path}-wal"), Path(f"{self.cache.path}-shm")):
                try:
                    path.unlink()
                    removed = True
                except FileNotFoundError:
                    pass
            self.set_status("Local cache cleared." if removed else "Local cache was already empty.")

        dialog.choose(self.window, None, finished)

    def on_search(self, _widget) -> None:
        query = self.search_entry.get_text().strip()
        if not query:
            self.set_status("Type a package name first.")
            self.search_entry.grab_focus()
            return

        self.view_mode = "search"
        if self.installed_button.get_active():
            self.installed_button.set_active(False)
        self.request_id += 1
        request_id = self.request_id
        backend = self.selected_source()
        if backend == "all" and CORE.is_git_url(query):
            backend = "git"
        source_label = self.sources[self.source_dropdown.get_selected()][0]
        if backend == "git":
            source_label = "Git repository"
        self.set_status(f"Searching {source_label.lower()} for {query!r}…", busy=True)

        cached_engine = CORE.headless_ui()
        managers = cached_engine.enabled_search_managers(backend)
        cached = cached_engine.cache.load_search(query, managers)
        if cached:
            cached = cached_engine.rank_results(cached_engine.dedupe_items(cached), query)
            self.show_items(cached, f"Results for “{query}” · refreshing")

        def worker() -> None:
            try:
                engine = CORE.headless_ui()
                results = engine.search_packages(query, backend)
                GLib.idle_add(self.finish_search, request_id, query, results, "")
            except Exception as exc:  # noqa: BLE001 - keep GUI alive if one backend breaks.
                GLib.idle_add(self.finish_search, request_id, query, [], str(exc))

        threading.Thread(target=worker, daemon=True).start()

    def finish_search(self, request_id: int, query: str, items: list, error: str) -> bool:
        if request_id != self.request_id or self.view_mode != "search":
            return False
        if error:
            self.set_status(f"Search failed: {error}")
            return False
        self.show_items(items, f"Results for “{query}”")
        suffix = f" · showing first {MAX_GUI_RESULTS}" if len(items) > MAX_GUI_RESULTS else ""
        self.set_status(f"Found {len(items)} packages{suffix}.")
        return False

    def on_installed_toggled(self, button: Gtk.ToggleButton) -> None:
        if not button.get_active():
            return
        self.view_mode = "installed"
        self.request_id += 1
        request_id = self.request_id
        cached = self.cache.load_installed()
        if cached:
            self.show_items(cached, "Installed packages · refreshing")
        self.set_status("Refreshing installed packages…", busy=True)

        def worker() -> None:
            try:
                items = CORE.collect_installed_packages(self.tools)
                self.cache.save_installed(items)
                GLib.idle_add(self.finish_installed, request_id, items, "")
            except Exception as exc:  # noqa: BLE001
                GLib.idle_add(self.finish_installed, request_id, [], str(exc))

        threading.Thread(target=worker, daemon=True).start()

    def finish_installed(self, request_id: int, items: list, error: str) -> bool:
        if request_id != self.request_id or self.view_mode != "installed":
            return False
        if error:
            self.set_status(f"Installed-package refresh failed: {error}")
            return False
        source = self.selected_source()
        filtered = [item for item in items if self.source_matches(item, source)]
        label = self.sources[self.source_dropdown.get_selected()][0]
        self.raw_items = list(items)
        self.show_items(filtered, "Installed packages" if source == "all" else f"Installed · {label}", remember=False)
        self.set_status(f"{len(filtered)} installed packages" + ("." if source == "all" else f" from {label.lower()}."))
        return False

    def on_row_selected(self, _listbox, row: PackageRow | None) -> None:
        if row is None:
            return
        item = row.item
        self.current_item = item
        self.detail_actions.set_visible(True)
        self.detail_name.set_halign(Gtk.Align.FILL)
        self.detail_name.set_xalign(0)
        self.detail_name.set_margin_top(18)
        self.detail_meta.set_halign(Gtk.Align.FILL)
        self.detail_meta.set_xalign(0)
        self.detail_name.set_text(item.title())
        state = "installed" if item.installed else "available"
        meta = [
            f"{item.source} · {state}",
            f"package: {item.package_id}",
            f"version: {item.version or 'unknown'}",
        ]
        if item.repo:
            meta.append(f"repository: {item.repo}")
        self.detail_meta.set_text("\n".join(meta))
        description = item.description or "No description available."
        if item.source == "nix" or item.manager == "nix":
            description += "\n\nPacmangr changes only your imperative Nix profile. Declarative NixOS or Home Manager files are left untouched."
        self.detail_text.get_buffer().set_text(description)
        self.info_button.set_sensitive(True)
        self.versions_button.set_sensitive(item.source in {"pacman", "aur", "aur/local", "apt"} or item.manager in {"pacman", "yay", "paru"})
        self.install_button.set_label("Reinstall" if item.installed else "Install")
        if item.source == "git":
            self.install_button.set_label("Update checkout" if item.installed else "Fetch repository")
        self.install_button.set_sensitive(item.source != "appimage")
        self.remove_button.set_sensitive((item.installed or item.source == "appimage") and item.source != "git")

    def on_info(self, _button) -> None:
        item = self.current_item
        if not item:
            return
        command = item.info_command(self.tools, self.view_mode == "installed")
        if not command:
            self.set_status(f"No details command is available for {item.title()}.")
            return
        self.set_status(f"Loading details for {item.title()}…", busy=True)

        def worker() -> None:
            code, output = CORE.run_capture(command, timeout=30)
            GLib.idle_add(self.finish_info, item, code, output)

        threading.Thread(target=worker, daemon=True).start()

    def finish_info(self, item, code: int, output: str) -> bool:
        if self.current_item is not item:
            return False
        text = output.strip() or f"Details command exited {code} without output."
        self.detail_text.get_buffer().set_text(text)
        self.set_status(
            f"Loaded details for {item.title()}." if code == 0
            else f"Details command exited {code}."
        )
        return False

    def on_versions(self, _button) -> None:
        item = self.current_item
        if not item:
            return
        manager = item.manager or item.source
        cached = self.cache.load_versions(manager, item.package_id)
        if cached:
            self.detail_text.get_buffer().set_text(CORE.format_versions(item.package_id, cached))
        self.set_status(f"Checking versions for {item.title()}…", busy=True)

        def worker() -> None:
            try:
                versions = CORE.package_versions(self.tools, item)
                if versions:
                    self.cache.save_versions(manager, item.package_id, versions)
                GLib.idle_add(self.finish_versions, item, versions, "")
            except Exception as exc:  # noqa: BLE001
                GLib.idle_add(self.finish_versions, item, [], str(exc))

        threading.Thread(target=worker, daemon=True).start()

    def finish_versions(self, item, versions: list, error: str) -> bool:
        if self.current_item is not item:
            return False
        if error:
            self.set_status(f"Version check failed: {error}")
            return False
        self.detail_text.get_buffer().set_text(CORE.format_versions(item.package_id, versions))
        self.set_status(f"Found {len(versions)} versions for {item.title()}.")
        return False

    def confirm_update_all(self, _button) -> None:
        if not self.window:
            return
        commands = CORE.system_update_commands(self.tools)
        if not commands:
            self.set_status("No update-capable package manager was detected.")
            return
        detail = "The following native package managers will run in order:\n\n" + "\n".join(
            f"• {label}: {shlex.join(command)}" for label, command in commands
        )
        dialog = Gtk.AlertDialog()
        dialog.set_message("Update all package sources?")
        dialog.set_detail(detail)
        dialog.set_buttons(["Cancel", "Update all"])
        dialog.set_cancel_button(0)
        dialog.set_default_button(1)

        def finished(alert: Gtk.AlertDialog, result) -> None:
            try:
                response = alert.choose_finish(result)
            except GLib.Error:
                return
            if response == 1:
                self.launch_maintenance(commands)

        dialog.choose(self.window, None, finished)

    def launch_maintenance(self, commands: list[tuple[str, list[str]]]) -> None:
        if self.operation_running:
            self.set_status("Another package operation is already running.")
            return
        prepared: list[tuple[str, list[str]]] = []
        try:
            for label, command in commands:
                prepared.append((label, prepare_gui_operation(command, self.tools, "update", shutil.which("pkexec"))))
        except RuntimeError as exc:
            self.set_status(str(exc))
            return
        self.operation_running = True
        self.install_button.set_sensitive(False)
        self.remove_button.set_sensitive(False)
        if self.package_activity:
            self.package_activity.start("update")
        self.start_operation_progress()
        self.set_status(f"Updating {len(prepared)} package sources…", busy=True)

        def worker() -> None:
            outputs: list[str] = []
            code = 0
            env = os.environ.copy()
            env.update({"DEBIAN_FRONTEND": "noninteractive", "LC_ALL": "C"})
            env.setdefault("TERM", "xterm-256color")
            for label, argv in prepared:
                GLib.idle_add(self.set_status, f"Updating {label}…", True)
                try:
                    code, output = run_streamed_operation(
                        argv,
                        env,
                        lambda line: GLib.idle_add(self.update_operation_progress, line),
                    )
                except OSError as exc:
                    code, output = 126, f"Could not start {label}: {exc}"
                outputs.append(f"[{label}]\n{output.strip()}")
                if code != 0:
                    break
            GLib.idle_add(self.finish_maintenance, code, "\n\n".join(outputs))

        threading.Thread(target=worker, daemon=True).start()

    def finish_maintenance(self, code: int, output: str) -> bool:
        self.operation_running = False
        if self.package_activity:
            self.package_activity.stop()
        self.stop_operation_progress()
        self.detail_text.get_buffer().set_text(output or "No package-manager output.")
        self.set_status("All package updates completed." if code == 0 else f"Package update stopped with status {code}.")
        return False

    def confirm_action(self, action: str, install_scope: str | None = None) -> None:
        item = self.current_item
        if not item or not self.window:
            return
        if action == "install" and (item.source == "pip" or item.manager == "pip") and install_scope is None:
            self.choose_pip_scope(item)
            return
        command = (
            item.install_command(self.tools, install_scope=install_scope or "user")
            if action == "install"
            else item.remove_command(self.tools)
        )
        if not command:
            self.set_status(f"No {action} command is available for {item.title()}.")
            return

        dialog = Gtk.AlertDialog()
        dialog.set_message(f"{action.title()} {item.title()}?")
        dialog.set_detail(
            "This runs quietly in the background. If administrator access is "
            "needed, the desktop will show a graphical password prompt.\n\n"
            + shlex.join(command)
        )
        dialog.set_buttons(["Cancel", action.title()])
        dialog.set_cancel_button(0)
        dialog.set_default_button(1)

        def finished(alert: Gtk.AlertDialog, result) -> None:
            try:
                response = alert.choose_finish(result)
            except GLib.Error:
                return
            if response == 1:
                self.launch_operation(action, item, command)

        dialog.choose(self.window, None, finished)

    def choose_pip_scope(self, item) -> None:
        if not self.window:
            return
        dialog = Gtk.AlertDialog()
        dialog.set_message(f"Where should {item.title()} be installed?")
        dialog.set_detail(
            "Venv keeps the package isolated under ~/.local/share/pacmangr/venvs and is recommended.\n\n"
            "User installs into your user Python environment. System is privileged and changes the OS Python environment."
        )
        dialog.set_buttons(["Cancel", "Venv · recommended", "User", "System"])
        dialog.set_cancel_button(0)
        dialog.set_default_button(1)

        def finished(alert: Gtk.AlertDialog, result) -> None:
            try:
                response = alert.choose_finish(result)
            except GLib.Error:
                return
            scopes = {1: "venv", 2: "user", 3: "system"}
            scope = scopes.get(response)
            if scope:
                self.confirm_action("install", install_scope=scope)

        dialog.choose(self.window, None, finished)

    def launch_operation(self, action: str, item, command: list[str]) -> None:
        if self.operation_running:
            self.set_status("Another package operation is already running.")
            return
        try:
            argv = prepare_gui_operation(
                command,
                self.tools,
                action,
                shutil.which("pkexec"),
            )
        except RuntimeError as exc:
            self.set_status(str(exc))
            return

        self.operation_running = True
        self.install_button.set_sensitive(False)
        self.remove_button.set_sensitive(False)
        verb = "Installing" if action == "install" else "Removing"
        if self.package_activity:
            self.package_activity.start(action)
        self.start_operation_progress()
        self.set_status(f"{verb} {item.title()} in the background…", busy=True)

        def worker() -> None:
            env = os.environ.copy()
            env["DEBIAN_FRONTEND"] = "noninteractive"
            env["LC_ALL"] = "C"
            env.setdefault("TERM", "xterm-256color")
            try:
                code, output = run_streamed_operation(
                    argv,
                    env=env,
                    on_line=lambda line: GLib.idle_add(
                        self.update_operation_progress,
                        line,
                    ),
                )
            except OSError as exc:
                output = f"Could not start package operation: {exc}"
                code = 126
            GLib.idle_add(self.finish_operation, action, item, code, output)

        threading.Thread(target=worker, daemon=True).start()

    def finish_operation(self, action: str, item, code: int, output: str) -> bool:
        self.operation_running = False
        if self.package_activity:
            self.package_activity.stop()
        self.stop_operation_progress()
        text = output.strip() or f"The package manager exited with status {code}."
        self.detail_text.get_buffer().set_text(text)
        if code == 0:
            item.installed = action == "install"
            self.set_status(f"{action.title()} completed for {item.title()}.")
        elif code in {126, 127} and "pkexec" in text:
            self.set_status("Graphical authentication is unavailable; package operation stopped.")
        else:
            last_line = text.splitlines()[-1]
            self.set_status(f"{action.title()} failed ({code}): {last_line}")

        if self.current_item is item:
            self.install_button.set_label("Reinstall" if item.installed else "Install")
            if item.source == "git":
                self.install_button.set_label("Update checkout" if item.installed else "Fetch repository")
            self.install_button.set_sensitive(item.source != "appimage")
            self.remove_button.set_sensitive((item.installed or item.source == "appimage") and item.source != "git")
        return False

    def on_open_tui(self, _button) -> None:
        terminal = shutil.which("foot") or shutil.which("xterm")
        pacmangr = shutil.which("pacmangr") or str(Path(__file__).resolve().with_name("pacmangr"))
        if not terminal:
            self.set_status("No terminal found.")
            return
        argv = (
            [terminal, "-a", "pacmangr-tui", "-T", "pacmangr", pacmangr]
            if Path(terminal).name == "foot"
            else [terminal, "-T", "pacmangr", "-e", pacmangr]
        )
        subprocess.Popen(argv, start_new_session=True)

    def do_shutdown(self) -> None:
        if self.package_activity:
            self.package_activity.stop()
        self.stop_operation_progress()
        Gtk.Application.do_shutdown(self)


if __name__ == "__main__":
    if len(sys.argv) > 1 and sys.argv[1] in {"-V", "--version"}:
        print(f"pacmangr-gui {CORE.VERSION}")
        raise SystemExit(0)
    raise SystemExit(PacmangrGUI().run(sys.argv))