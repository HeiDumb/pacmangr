def prepare_gui_operation(
    command: list[str],
    tools,
    action: str,
    pkexec: str | None,
) -> list[str]:
    """Make a package command non-interactive and GUI-authenticated."""
    if not command:
        raise RuntimeError("The package manager returned an empty command.")

    argv = list(command)
    privilege_tools = {path for path in (tools.sudo, tools.doas) if path}
    if argv[0] in privilege_tools:
        if not pkexec:
            raise RuntimeError("Graphical authentication needs polkit (pkexec).")
        argv = [pkexec, *argv[1:]]

    executable_index = 1 if pkexec and argv[0] == pkexec else 0
    executable = Path(argv[executable_index]).name
    operation_index = executable_index + 1
    operation = argv[operation_index] if len(argv) > operation_index else ""

    if executable in {"yay", "paru"}:
        if not pkexec:
            raise RuntimeError("AUR installation needs polkit (pkexec).")
        argv[executable_index + 1:executable_index + 1] = ["--sudo", pkexec]

    flags: list[str] = []
    if executable in {"pacman", "yay", "paru"}:
        flags = ["--noconfirm"]
        if action == "install":
            flags.append("--needed")
    elif executable == "flatpak":
        flags = ["--noninteractive", "-y"]
    elif executable == "apt":
        flags = ["-y"]
    elif executable in {"dnf", "xbps-install", "xbps-remove", "eopkg"}:
        flags = ["-y"]
    elif executable == "zypper":
        flags = ["--non-interactive"]

    if flags:
        operation_index = argv.index(operation, executable_index + 1)
        argv[operation_index + 1:operation_index + 1] = [
            flag for flag in flags if flag not in argv
        ]
    return argv


def ensure_graphical_auth_agent() -> bool:
    """Start an installed desktop polkit agent when the session has none."""
    agent_names = (
        "polkit-gnome-authentication-agent-1",
        "polkit-kde-authentication-agent-1",
        "lxqt-policykit-agent",
        "hyprpolkitagent",
    )
    for name in agent_names:
        result = subprocess.run(
            ["pgrep", "-f", f"(^|/){name}( |$)"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=False,
        )
        if result.returncode == 0:
            return True

    candidates = (
        "/usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1",
        "/usr/lib/polkit-kde-authentication-agent-1",
        "/usr/lib/lxqt-policykit-agent",
        "/usr/lib/hyprpolkitagent/hyprpolkitagent",
    )
    for candidate in candidates:
        if not Path(candidate).is_file():
            continue
        try:
            subprocess.Popen(
                [candidate],
                stdin=subprocess.DEVNULL,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                start_new_session=True,
            )
        except OSError:
            continue
        return True
    return False


def source_choices(tools) -> list[tuple[str, str]]:
    """Return available search scopes in a predictable desktop-friendly order."""
    choices = [("All sources", "all")]
    known = (
        ("System packages", "pacman", tools.pacman),
        ("AUR · yay", "yay", tools.yay),
        ("AUR · paru", "paru", tools.paru),
        ("Flatpak", "flatpak", tools.flatpak),
        ("APT", "apt", tools.apt_cache),
        ("Snap", "snap", tools.snap),
        ("Git repository", "git", getattr(tools, "git", None)),
    )
    choices.extend((label, key) for label, key, path in known if path)
    for manager in tools.extra_managers:
        if "search" in CORE.MANAGER_SPECS.get(manager, {}):
            choices.append((manager.replace("-", " ").title(), manager))
    choices.append(("Local AppImages", "appimage"))
    return choices


def cache_summary(cache) -> str:
    if not cache.path.exists():
        return f"Cache is empty.\n\n{cache.path}"
    lines = [f"Location\n{cache.path}", f"Size\n{CORE.human_size(cache.path.stat().st_size)}"]
    try:
        with cache.connect() as conn:
            labels = (
                ("search_cache", "Search results"),
                ("installed_packages", "Installed packages"),
                ("version_cache", "Package versions"),
            )
            for table, label in labels:
                count = conn.execute(f"SELECT COUNT(*) FROM {table}").fetchone()[0]
                lines.append(f"{label}\n{count}")
    except Exception as exc:  # noqa: BLE001 - diagnostics must stay usable with a bad cache.
        lines.append(f"Database status\nUnreadable: {exc}")
    return "\n\n".join(lines)


