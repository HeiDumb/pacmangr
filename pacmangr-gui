def hex_rgb(value: str, fallback: str = "ffffff") -> tuple[float, float, float]:
    """Convert a CSS-style hex colour to Cairo's zero-to-one RGB tuple."""
    clean = value.strip().lstrip("#")
    if len(clean) == 3:
        clean = "".join(channel * 2 for channel in clean)
    if len(clean) != 6:
        clean = fallback
    try:
        channels = tuple(int(clean[index:index + 2], 16) / 255 for index in (0, 2, 4))
    except ValueError:
        channels = tuple(int(fallback[index:index + 2], 16) / 255 for index in (0, 2, 4))
    return channels


def pacman_frame(phase: float, width: float) -> tuple[float, tuple[float, ...]]:
    """Return mouth angle and moving pellet positions for one animation frame."""
    mouth = math.radians(8 + 22 * (0.5 + 0.5 * math.sin(phase * 0.9)))
    track_start = 31.0
    pellet_gap = 18.0
    offset = (phase * 2.8) % pellet_gap
    pellet_x = track_start + pellet_gap - offset
    positions: list[float] = []
    while pellet_x < max(track_start + pellet_gap, width - 4):
        positions.append(pellet_x)
        pellet_x += pellet_gap
    return mouth, tuple(positions)


def parse_operation_progress(
    raw_line: str,
) -> tuple[str, int | None, str, str]:
    """Extract displayable progress from native package-manager output."""
    line = CORE.strip_ansi(raw_line).replace("\b", "").strip()
    if not line:
        return "", None, "", ""
    percentages = CORE.PERCENT_RE.findall(line)
    speeds = CORE.SPEED_RE.findall(line)
    etas = CORE.ETA_RE.findall(line)
    percent = int(percentages[-1]) if percentages else None
    speed = speeds[-1] if speeds else ""
    eta = etas[-1] if etas and ("eta" in line.lower() or speed) else ""
    return line, percent, speed, eta


def format_eta(seconds: float) -> str:
    """Format an estimated duration compactly for the progress bar."""
    remaining = max(0, int(round(seconds)))
    hours, remainder = divmod(remaining, 3600)
    minutes, secs = divmod(remainder, 60)
    if hours:
        return f"{hours}:{minutes:02d}:{secs:02d}"
    return f"{minutes}:{secs:02d}"


def run_streamed_operation(
    argv: list[str],
    env: dict[str, str],
    on_line,
    timeout: float = 30 * 60,
) -> tuple[int, str]:
    """Run against a pseudo-terminal so native progress bars remain visible."""
    master_fd, slave_fd = pty.openpty()
    try:
        # Native package managers hide their download meters when stdout is not
        # a terminal. A stable width keeps percentage, speed, and ETA together.
        fcntl.ioctl(
            slave_fd,
            termios.TIOCSWINSZ,
            struct.pack("HHHH", 24, 120, 0, 0),
        )
        process = subprocess.Popen(
            argv,
            stdin=subprocess.DEVNULL,
            stdout=slave_fd,
            stderr=slave_fd,
            text=False,
            bufsize=0,
            env=env,
            start_new_session=True,
        )
    except Exception:
        os.close(master_fd)
        os.close(slave_fd)
        raise
    else:
        os.close(slave_fd)

    started = time.monotonic()
    buffer = ""
    lines: list[str] = []
    timed_out = False
    try:
        while True:
            if time.monotonic() - started >= timeout:
                timed_out = True
                try:
                    os.killpg(process.pid, signal.SIGKILL)
                except (OSError, ProcessLookupError):
                    process.kill()
                break

            ready, _, _ = select.select([master_fd], [], [], 0.20)
            if not ready:
                if process.poll() is not None:
                    break
                continue

            try:
                chunk = os.read(master_fd, 4096)
            except OSError:
                break
            if not chunk:
                break

            for character in chunk.decode(errors="replace"):
                if character in "\r\n":
                    line = buffer.strip("\r\n")
                    buffer = ""
                    if not line:
                        continue
                    lines.append(line)
                    lines = lines[-2000:]
                    on_line(line)
                else:
                    buffer += character
    finally:
        try:
            os.close(master_fd)
        except OSError:
            pass

    if buffer.strip():
        lines.append(buffer.strip())
        on_line(buffer.strip())
    code = process.wait()
    if timed_out:
        timeout_line = "Operation timed out after 30 minutes."
        lines.append(timeout_line)
        on_line(timeout_line)
        code = 124
    return code, "\n".join(lines)


class PacmanActivity(Gtk.DrawingArea):
    """Small, themed Pac-Man activity indicator for package operations."""

    def __init__(self, colours: dict[str, str]) -> None:
        super().__init__()
        self._phase = 0.0
        self._active = False
        self._mode = "install"
        self._source_id = 0
        self._body = hex_rgb(colours["primary"])
        self._eye = hex_rgb(colours["on_primary"])
        self._pellet = hex_rgb(colours["success"])
        self._remove_pellet = hex_rgb(colours["error"])
        self.set_content_width(148)
        self.set_content_height(30)
        self.set_size_request(148, 30)
        self.set_draw_func(self._draw)
        self.set_visible(False)

    def start(self, mode: str = "install") -> None:
        self._mode = mode
        self._active = True
        self.set_visible(True)
        action = {
            "install": "Installing package",
            "remove": "Removing package",
            "update": "Updating packages",
        }.get(mode, "Package operation")
        self.set_tooltip_text(f"{action} in the background")
        self.queue_draw()

        settings = Gtk.Settings.get_default()
        animations_enabled = (
            settings is None
            or settings.get_property("gtk-enable-animations")
        )
        if animations_enabled and not self._source_id:
            self._source_id = GLib.timeout_add(50, self._tick)

    def stop(self) -> None:
        self._active = False
        if self._source_id:
            GLib.source_remove(self._source_id)
            self._source_id = 0
        self.set_visible(False)

    def _tick(self) -> bool:
        if not self._active:
            self._source_id = 0
            return GLib.SOURCE_REMOVE
        self._phase = (self._phase + 1.0) % 3600
        self.queue_draw()
        return GLib.SOURCE_CONTINUE

    def _draw(self, _area, context, width: int, height: int) -> None:
        if not self._active:
            return

        center_x = 15.0
        center_y = height / 2
        radius = min(10.0, max(6.0, center_y - 3))
        mouth, pellets = pacman_frame(self._phase, width)

        context.set_source_rgb(*self._body)
        context.move_to(center_x, center_y)
        context.arc(center_x, center_y, radius, mouth, math.tau - mouth)
        context.close_path()
        context.fill()

        context.set_source_rgb(*self._eye)
        context.arc(center_x + 1.5, center_y - radius * 0.48, 1.35, 0, math.tau)
        context.fill()

        pellet_colour = self._remove_pellet if self._mode == "remove" else self._pellet
        mouth_edge = center_x + radius + 2
        for pellet_x in pellets:
            if pellet_x <= mouth_edge:
                continue
            fade = min(1.0, (pellet_x - mouth_edge) / 8)
            context.set_source_rgba(*pellet_colour, 0.90 * fade)
            context.arc(pellet_x, center_y, 2.35, 0, math.tau)
            context.fill()


class PacmangrLogo(Gtk.DrawingArea):
    """Compact themed Pac-Man mark for the application header."""

    def __init__(self, colours: dict[str, str]) -> None:
        super().__init__()
        self._body = hex_rgb(colours["primary"])
        self._eye = hex_rgb(colours["on_primary"])
        self._pellet = hex_rgb(colours["success"])
        # Keep the brand mark at a normal header-bar icon size. The drawing
        # area stays compact so it cannot inflate the title bar height.
        self.set_content_width(30)
        self.set_content_height(30)
        self.set_size_request(30, 30)
        self.set_draw_func(self._draw)

    def _draw(self, _area, context, width: int, height: int) -> None:
        center_x, center_y = 13.5, height / 2
        radius = 12.5
        mouth = math.radians(24)
        context.set_source_rgb(*self._body)
        context.move_to(center_x, center_y)
        context.arc(center_x, center_y, radius, mouth, math.tau - mouth)
        context.close_path()
        context.fill()
        context.set_source_rgb(*self._eye)
        context.arc(center_x + 1.0, center_y - 5.5, 1.5, 0, math.tau)
        context.fill()
        context.set_source_rgb(*self._pellet)
        context.arc(width - 3.0, center_y, 2.2, 0, math.tau)
        context.fill()


class PackageRow(Gtk.ListBoxRow):
    def __init__(self, item) -> None:
        super().__init__()
        self.item = item
        self.add_css_class("package-row")

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=5)
        box.set_margin_top(10)
        box.set_margin_bottom(10)
        box.set_margin_start(12)
        box.set_margin_end(12)

        top = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        name = Gtk.Label(label=item.title(), xalign=0)
        name.set_hexpand(True)
        name.set_ellipsize(3)
        name.add_css_class("package-name")
        top.append(name)

        source = Gtk.Label(label=item.source)
        source.add_css_class("pill")
        top.append(source)
        if item.installed:
            installed = Gtk.Label(label="installed")
            installed.add_css_class("pill")
            installed.add_css_class("installed-pill")
            top.append(installed)
        box.append(top)

        meta_text = item.version or "version unknown"
        if item.repo:
            meta_text += f"  ·  {item.repo}"
        meta = Gtk.Label(label=meta_text, xalign=0)
        meta.set_ellipsize(3)
        meta.add_css_class("muted")
        box.append(meta)

        if item.description:
            desc = Gtk.Label(label=item.description, xalign=0)
            desc.set_ellipsize(3)
            desc.add_css_class("muted")
            box.append(desc)

        self.set_child(box)


class PacmangrGUI(Gtk.Application):
    def __init__(self) -> None:
        super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.DEFAULT_FLAGS)
        self.window: Gtk.ApplicationWindow | None = None
        self.tools = CORE.Tools.detect()
        self.cache = CORE.PackageCache()
        self.items: list = []
        self.raw_items: list = []
        self.current_item = None
        self.sources = source_choices(self.tools)
        self.request_id = 0
        self.view_mode = "search"
        self.operation_running = False
        self.package_activity: PacmanActivity | None = None
        self.operation_progress: Gtk.ProgressBar | None = None
        self.operation_progress_source = 0
        self.operation_started = 0.0
        self.operation_phase_started = 0.0
        self.operation_percent: int | None = None
        self.operation_speed = ""
        self.operation_eta = ""

    def do_activate(self) -> None:
        if self.window:
            self.window.present()
            self.search_entry.grab_focus()
            return

        ensure_graphical_auth_agent()
        install_css()
        self.window = Gtk.ApplicationWindow(application=self)
        self.window.set_title("pacmangr")
        self.window.set_default_size(1180, 760)
        self.window.set_size_request(840, 560)
        self.window.add_controller(self.make_escape_controller())

        self.build_header()
        self.build_content()
        self.window.present()
        self.search_entry.grab_focus()

    def build_header(self) -> None:
        assert self.window
        header = Gtk.HeaderBar()
        header.set_show_title_buttons(False)

        # Use the Pacmangr exit artwork instead of a generic cross icon.
        close_button = Gtk.Button()
        close_button.set_tooltip_text("Close Pacmangr")
        close_button.add_css_class("flat")
        close_button.add_css_class("pacmangr-exit-button")
        # Match the 30 px Pac-Man drawing area without enlarging the header bar.
        close_button.set_size_request(30, 30)
        script_dir = Path(__file__).resolve().parent
        exit_icon_candidates = (
            script_dir / "assets" / "pacmangr-exit.png",
            script_dir / "pacmangr-exit.png",  # backward-compatible checkout
            Path("/usr/share/pacmangr/assets/pacmangr-exit.png"),
            Path("/usr/local/share/pacmangr/assets/pacmangr-exit.png"),
        )
        exit_icon_path = next(
            (candidate for candidate in exit_icon_candidates if candidate.is_file()),
            exit_icon_candidates[0],
        )
        if exit_icon_path.is_file():
            # The PNG is pre-sized to 30 × 30 px and the picture is constrained
            # to the same dimensions as the Pac-Man header logo.
            exit_icon = Gtk.Picture.new_for_filename(str(exit_icon_path))
            exit_icon.set_can_shrink(True)
            exit_icon.set_content_fit(Gtk.ContentFit.CONTAIN)
            exit_icon.set_size_request(30, 30)
            close_button.set_child(exit_icon)
        else:
            # Keep the close action available if the artwork asset is missing.
            close_button.set_icon_name("window-close-symbolic")
        close_button.connect("clicked", lambda _button: self.window.close())
        header.pack_end(close_button)

        brand = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        brand.append(PacmangrLogo(palette()))
        copy = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        title = Gtk.Label(label="pacmangr", xalign=0)
        title.add_css_class("title-label")
