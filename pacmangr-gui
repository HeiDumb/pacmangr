#!/usr/bin/env python3
"""Thin launcher for the organised pacmangr GTK front-end.

The implementation now lives in the ``pacmangr_gui`` package next to this file.
All public names are re-exported so existing imports and tests keep working.
"""

from __future__ import annotations

import sys
from pathlib import Path

_here = str(Path(__file__).resolve().parent)
if _here not in sys.path:
    sys.path.insert(0, _here)

from pacmangr_gui import *  # noqa: E402,F401,F403
from pacmangr_gui import __all__  # noqa: E402,F401


if __name__ == "__main__":
    from pacmangr_gui.main import main

    raise SystemExit(main())
