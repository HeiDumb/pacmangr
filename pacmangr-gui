        "background": colours.get("background", defaults["background"]),
        "surface": colours.get("surfaceContainer", defaults["surface"]),
        "surface_high": colours.get("surfaceContainerHighest", defaults["surface_high"]),
        "text": colours.get("onSurface", defaults["text"]),
