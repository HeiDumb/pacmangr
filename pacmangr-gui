        "background": "0c0e12",
        "surface": "161a1f",
        "surface_high": "21262d",
        "text": "e1e6ef",
        "muted": "a6abb4",
        "outline": "434850",
        "primary": "adc9ea",
        "on_primary": "26425e",
        "success": "b5ccba",
        "error": "fa746f",
