pkgbase = pacmangr
	pkgdesc = Unified terminal and GTK interface for native package managers
	pkgver = 0.3.0
	pkgrel = 1
	url = https://github.com/HeiDumb/pacmangr
	arch = any
	license = MIT
	depends = python
	depends = python-gobject
	depends = gtk4
	depends = polkit
	optdepends = pacman: Arch repository package support
	optdepends = yay: AUR package support
	optdepends = paru: alternate AUR package support
	optdepends = pacseek: interactive Arch package lookup
	optdepends = downgrade: Arch package version history and downgrade support
	optdepends = flatpak: Flatpak application support
	optdepends = git: managed Git repository fetching and updates
	optdepends = apt: Debian/Ubuntu package support
	optdepends = snapd: Snap package support
	optdepends = cargo: Rust crate support
	optdepends = npm: Node package support
	optdepends = python-pip: Python package support
	optdepends = pipx: Python application support
	optdepends = ruby: gem package support
	optdepends = luarocks: Lua package support
