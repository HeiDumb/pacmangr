            display,
            provider,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION,
        )
        CURRENT_CSS_PROVIDER = provider


def hex_rgb(value: str, fallback: str = "ffffff") -> tuple[float, float, float]:
    """Convert a CSS-style hex colour to Cairo's zero-to-one RGB tuple."""
    clean = value.strip().lstrip("#")
    if len(clean) == 3:
        clean = "".join(channel * 2 for channel in clean)
    if len(clean) != 6:
        clean = fallback
    try:
        channels = tuple(int(clean[index:index + 2], 16) / 255 for index in (0, 2, 4))
    except ValueError:
        channels = tuple(int(fallback[index:index + 2], 16) / 255 for index in (0, 2, 4))
    return channels


def pacman_frame(phase: float, width: float) -> tuple[float, tuple[float, ...]]:
    """Return mouth angle and moving pellet positions for one animation frame."""
    mouth = math.radians(8 + 22 * (0.5 + 0.5 * math.sin(phase * 0.9)))
    track_start = 31.0
    pellet_gap = 18.0
    offset = (phase * 2.8) % pellet_gap
    pellet_x = track_start + pellet_gap - offset
    positions: list[float] = []
    while pellet_x < max(track_start + pellet_gap, width - 4):
        positions.append(pellet_x)
        pellet_x += pellet_gap
    return mouth, tuple(positions)


def parse_operation_progress(
    raw_line: str,
) -> tuple[str, int | None, str, str]:
    """Extract displayable progress from native package-manager output."""
    line = CORE.strip_ansi(raw_line).replace("\b", "").strip()
    if not line:
        return "", None, "", ""
    percentages = CORE.PERCENT_RE.findall(line)
    speeds = CORE.SPEED_RE.findall(line)
    etas = CORE.ETA_RE.findall(line)
    percent = int(percentages[-1]) if percentages else None
    speed = speeds[-1] if speeds else ""
    eta = etas[-1] if etas and ("eta" in line.lower() or speed) else ""
    return line, percent, speed, eta


def format_eta(seconds: float) -> str:
    """Format an estimated duration compactly for the progress bar."""
    remaining = max(0, int(round(seconds)))
    hours, remainder = divmod(remaining, 3600)
    minutes, secs = divmod(remainder, 60)
    if hours:
        return f"{hours}:{minutes:02d}:{secs:02d}"
    return f"{minutes}:{secs:02d}"


def run_streamed_operation(
    argv: list[str],
    env: dict[str, str],
    on_line,
    timeout: float = 30 * 60,
) -> tuple[int, str]:
    """Run against a pseudo-terminal so native progress bars remain visible."""
    master_fd, slave_fd = pty.openpty()
    try:
        # Native package managers hide their download meters when stdout is not
        # a terminal. A stable width keeps percentage, speed, and ETA together.
        fcntl.ioctl(
            slave_fd,
            termios.TIOCSWINSZ,
            struct.pack("HHHH", 24, 120, 0, 0),
        )
        process = subprocess.Popen(
            argv,
            stdin=subprocess.DEVNULL,
            stdout=slave_fd,
            stderr=slave_fd,
            text=False,
            bufsize=0,
            env=env,
            start_new_session=True,
        )
    except Exception:
        os.close(master_fd)
        os.close(slave_fd)
        raise
    else:
        os.close(slave_fd)

    started = time.monotonic()
    buffer = ""
    lines: list[str] = []
    timed_out = False
    try:
        while True:
            if time.monotonic() - started >= timeout:
                timed_out = True
                try:
                    os.killpg(process.pid, signal.SIGKILL)
                except (OSError, ProcessLookupError):
                    process.kill()
                break

            ready, _, _ = select.select([master_fd], [], [], 0.20)
            if not ready:
                if process.poll() is not None:
                    break
                continue

            try:
                chunk = os.read(master_fd, 4096)
            except OSError:
                break
            if not chunk:
                break

            for character in chunk.decode(errors="replace"):
                if character in "\r\n":
                    line = buffer.strip("\r\n")
                    buffer = ""
                    if not line:
                        continue
                    lines.append(line)
                    lines = lines[-2000:]
                    on_line(line)
                else:
                    buffer += character
    finally:
        try:
            os.close(master_fd)
        except OSError:
            pass

    if buffer.strip():
        lines.append(buffer.strip())
        on_line(buffer.strip())
    code = process.wait()
    if timed_out:
        timeout_line = "Operation timed out after 30 minutes."
        lines.append(timeout_line)
        on_line(timeout_line)
        code = 124
    return code, "\n".join(lines)


class PacmanActivity(Gtk.DrawingArea):
    """Small, themed Pac-Man activity indicator for package operations."""

    def __init__(self, colours: dict[str, str]) -> None:
        super().__init__()
        self._phase = 0.0
        self._active = False
        self._mode = "install"
        self._source_id = 0
        self._body = hex_rgb(colours["primary"])
        self._eye = hex_rgb(colours["on_primary"])
        self._pellet = hex_rgb(colours["success"])
        self._remove_pellet = hex_rgb(colours["error"])
        self.set_content_width(148)
        self.set_content_height(30)
        self.set_size_request(148, 30)
        self.set_draw_func(self._draw)
        self.set_visible(False)

    def start(self, mode: str = "install") -> None:
        self._mode = mode
        self._active = True
        self.set_visible(True)
        action = {
            "install": "Installing package",
            "remove": "Removing package",
            "update": "Updating packages",
        }.get(mode, "Package operation")
        self.set_tooltip_text(f"{action} in the background")
        self.queue_draw()

        settings = Gtk.Settings.get_default()
        animations_enabled = (
            settings is None
            or settings.get_property("gtk-enable-animations")
        )
        if animations_enabled and not self._source_id:
            self._source_id = GLib.timeout_add(50, self._tick)

    def stop(self) -> None:
        self._active = False
        if self._source_id:
            GLib.source_remove(self._source_id)
            self._source_id = 0
        self.set_visible(False)

    def _tick(self) -> bool:
        if not self._active:
            self._source_id = 0
            return GLib.SOURCE_REMOVE
        self._phase = (self._phase + 1.0) % 3600
        self.queue_draw()
        return GLib.SOURCE_CONTINUE

    def _draw(self, _area, context, width: int, height: int) -> None:
        if not self._active:
            return

        center_x = 15.0
        center_y = height / 2
        radius = min(10.0, max(6.0, center_y - 3))
        mouth, pellets = pacman_frame(self._phase, width)

        context.set_source_rgb(*self._body)
        context.move_to(center_x, center_y)
        context.arc(center_x, center_y, radius, mouth, math.tau - mouth)
        context.close_path()
        context.fill()

        context.set_source_rgb(*self._eye)
        context.arc(center_x + 1.5, center_y - radius * 0.48, 1.35, 0, math.tau)
        context.fill()

        pellet_colour = self._remove_pellet if self._mode == "remove" else self._pellet
        mouth_edge = center_x + radius + 2
        for pellet_x in pellets:
            if pellet_x <= mouth_edge:
                continue
            fade = min(1.0, (pellet_x - mouth_edge) / 8)
            context.set_source_rgba(*pellet_colour, 0.90 * fade)
            context.arc(pellet_x, center_y, 2.35, 0, math.tau)
            context.fill()


class PacmangrLogo(Gtk.DrawingArea):
    """Compact themed Pac-Man mark for the application header."""

    def __init__(self, colours: dict[str, str]) -> None:
        super().__init__()
        self._body = hex_rgb(colours["primary"])
        self._eye = hex_rgb(colours["on_primary"])
        self._pellet = hex_rgb(colours["success"])
        # Keep the brand mark at a normal header-bar icon size. The drawing
        # area stays compact so it cannot inflate the title bar height.
        self.set_content_width(30)
        self.set_content_height(30)
        self.set_size_request(30, 30)
        self.set_draw_func(self._draw)

    def _draw(self, _area, context, width: int, height: int) -> None:
        center_x, center_y = 13.5, height / 2
        radius = 12.5
        mouth = math.radians(24)
        context.set_source_rgb(*self._body)
        context.move_to(center_x, center_y)
        context.arc(center_x, center_y, radius, mouth, math.tau - mouth)
        context.close_path()
        context.fill()
        context.set_source_rgb(*self._eye)
        context.arc(center_x + 1.0, center_y - 5.5, 1.5, 0, math.tau)
        context.fill()
        context.set_source_rgb(*self._pellet)
        context.arc(width - 3.0, center_y, 2.2, 0, math.tau)
        context.fill()


class PackageRow(Gtk.ListBoxRow):
    def __init__(self, item, *, compact: bool = False) -> None:
        super().__init__()
        self.item = item
        self.add_css_class("package-row")

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2 if compact else 4)
        box.add_css_class("package-row-box")
        if compact:
            box.add_css_class("compact")

        top = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        name = Gtk.Label(label=item.title(), xalign=0)
        name.set_hexpand(True)
        name.set_ellipsize(3)
        name.add_css_class("package-name")
        top.append(name)

        source = Gtk.Label(label=item.source)
        source.add_css_class("pill")
        top.append(source)

        if getattr(item, "is_orphan", False):
            orphan_pill = Gtk.Label(label="orphan")
            orphan_pill.add_css_class("pill")
            orphan_pill.add_css_class("orphan-pill")
            top.append(orphan_pill)
        elif getattr(item, "install_reason", "") == "explicit":
            exp_pill = Gtk.Label(label="explicit")
            exp_pill.add_css_class("pill")
            exp_pill.add_css_class("explicit-pill")
            top.append(exp_pill)

        if item.installed and not compact:
            installed = Gtk.Label(label="installed")
            installed.add_css_class("pill")
            installed.add_css_class("installed-pill")
            top.append(installed)
        box.append(top)

        meta_text = item.version or "version unknown"
        if item.repo:
            meta_text += f"  ·  {item.repo}"
        meta = Gtk.Label(label=meta_text, xalign=0)
        meta.set_ellipsize(3)
        meta.add_css_class("muted")
        box.append(meta)

        if item.description and not compact:
            desc = Gtk.Label(label=item.description, xalign=0)
            desc.set_ellipsize(3)
            desc.add_css_class("muted")
            box.append(desc)

        self.set_child(box)


class SettingsDialog(Gtk.Window):
    """Preferences and configuration window for pacmangr."""

    def __init__(self, app) -> None:
        super().__init__(transient_for=app.window, modal=True)
        self.app = app
        self.set_title("Pacmangr Settings")
        self.set_default_size(520, 480)
        self.set_resizable(False)

        header = Gtk.HeaderBar()
        header.set_show_title_buttons(True)
        header.set_title_widget(Gtk.Label(label="Settings", css_classes=["title-label"]))
        self.set_titlebar(header)

        scroll = Gtk.ScrolledWindow()
        scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        self.set_child(scroll)

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        box.set_margin_top(16)
        box.set_margin_bottom(16)
        box.set_margin_start(20)
        box.set_margin_end(20)
        scroll.set_child(box)

        # --- General Section ---
        box.append(self._make_section_header("GENERAL"))

        # Default View
        row_view, self.view_combo = self._make_dropdown_row(
            "Default Startup Tab",
            ["Install", "Installed Packages"],
            0 if SETTINGS.get("default_view") == "browse" else 1,
        )
        box.append(row_view)

        # Max Search Results
        result_options = ["50", "100", "250", "500"]
        curr_max = str(SETTINGS.get("max_results", 250))
        max_idx = result_options.index(curr_max) if curr_max in result_options else 2
        row_max, self.max_combo = self._make_dropdown_row(
            "Maximum Search Results",
            result_options,
            max_idx,
        )
        box.append(row_max)

        # Confirm actions
        row_confirm, self.confirm_switch = self._make_switch_row(
            "Confirm Package Actions",
            "Show confirmation before running install, remove, or update",
            bool(SETTINGS.get("confirm_actions", True)),
        )
        box.append(row_confirm)

        # Check updates on startup
        row_updates, self.updates_switch = self._make_switch_row(
            "Check Updates On Launch",
            "Automatically count upgradeable packages when pacmangr starts",
            bool(SETTINGS.get("check_updates_on_launch", False)),
        )
        box.append(row_updates)

        # --- Package Managers & Backends ---
        box.append(self._make_section_header("PACKAGE BACKENDS"))

        # AUR Helper
        aur_opts = ["Auto-detect", "yay", "paru", "Disabled"]
        curr_aur = SETTINGS.get("aur_helper", "auto")
        aur_idx = 0 if curr_aur == "auto" else (1 if curr_aur == "yay" else (2 if curr_aur == "paru" else 3))
        row_aur, self.aur_combo = self._make_dropdown_row(
            "Preferred AUR Helper",
            aur_opts,
            aur_idx,
        )
        box.append(row_aur)

        # Pip Scope
        pip_opts = ["Virtualenv (isolated)", "User directory (--user)", "System (--break-system-packages)"]
        curr_pip = SETTINGS.get("pip_scope", "venv")
        pip_idx = 0 if curr_pip == "venv" else (1 if curr_pip == "user" else 2)
        row_pip, self.pip_combo = self._make_dropdown_row(
            "Default Pip Install Scope",
            pip_opts,
            pip_idx,
        )
        box.append(row_pip)

        # Preferred Terminal
        row_term, self.term_entry = self._make_entry_row(
            "Preferred Terminal Emulator",
            SETTINGS.get("preferred_terminal", "auto"),
            "e.g. foot, kitty, alacritty, or auto",
        )
        box.append(row_term)

        # --- Appearance ---
        box.append(self._make_section_header("APPEARANCE"))

        # Theme accent
        acc_opts = ["Heilios Dynamic", "Pac-Man Gold", "Cyberpunk Cyan", "Neon Purple", "Emerald Green", "Sunset Coral"]
        acc_keys = ["auto", "gold", "cyan", "purple", "green", "coral"]
        curr_acc = SETTINGS.get("theme_accent", "auto")
        acc_idx = acc_keys.index(curr_acc) if curr_acc in acc_keys else 0
        row_acc, self.acc_combo = self._make_dropdown_row(
            "Theme Accent Color",
            acc_opts,
            acc_idx,
        )
        box.append(row_acc)

        # Pacman animation
        row_anim, self.anim_switch = self._make_switch_row(
            "Pac-Man Progress Animation",
            "Show animated Pac-Man eating pellets during operations",
            bool(SETTINGS.get("pacman_animation", True)),
        )
        box.append(row_anim)

        # Compact list rows
        row_comp, self.compact_switch = self._make_switch_row(
            "Compact List Rows",
            "Reduce row margins and padding to show more packages at once",
            bool(SETTINGS.get("compact_rows", False)),
        )
        box.append(row_comp)

        # Save Button
        save_btn = Gtk.Button(label="Save & Apply Settings")
        save_btn.add_css_class("suggested-action")
        save_btn.set_margin_top(12)
        save_btn.connect("clicked", self._on_save)
        box.append(save_btn)

    def _make_section_header(self, text: str) -> Gtk.Label:
        lbl = Gtk.Label(label=text, xalign=0)
        lbl.add_css_class("section-label")
        lbl.set_margin_top(8)
        return lbl

    def _make_dropdown_row(self, title: str, options: list[str], selected: int):
        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        lbl = Gtk.Label(label=title, xalign=0, hexpand=True)
        lbl.add_css_class("package-name")
        dropdown = Gtk.DropDown.new_from_strings(options)
        dropdown.set_selected(selected)
        dropdown.set_size_request(180, -1)
        row.append(lbl)
        row.append(dropdown)
        return row, dropdown

    def _make_switch_row(self, title: str, subtitle: str, active: bool):
        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2, hexpand=True)
        lbl = Gtk.Label(label=title, xalign=0)
        lbl.add_css_class("package-name")
        sub = Gtk.Label(label=subtitle, xalign=0)
        sub.add_css_class("muted")
        sub.set_wrap(True)
        vbox.append(lbl)
        vbox.append(sub)
        switch = Gtk.Switch()
        switch.set_active(active)
        switch.set_valign(Gtk.Align.CENTER)
        row.append(vbox)
        row.append(switch)
        return row, switch

    def _make_entry_row(self, title: str, value: str, placeholder: str):
        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        lbl = Gtk.Label(label=title, xalign=0, hexpand=True)
        lbl.add_css_class("package-name")
        entry = Gtk.Entry()
        entry.set_text(value)
        entry.set_placeholder_text(placeholder)
        entry.set_size_request(180, -1)
        row.append(lbl)
        row.append(entry)
        return row, entry

    def _on_save(self, _button) -> None:
        view_val = "browse" if self.view_combo.get_selected() == 0 else "installed"
        res_opts = [50, 100, 250, 500]
        max_val = res_opts[self.max_combo.get_selected()]
        confirm_val = self.confirm_switch.get_active()
        updates_val = self.updates_switch.get_active()

        aur_vals = ["auto", "yay", "paru", "disabled"]
        aur_val = aur_vals[self.aur_combo.get_selected()]

        pip_vals = ["venv", "user", "system"]
        pip_val = pip_vals[self.pip_combo.get_selected()]

        term_val = self.term_entry.get_text().strip() or "auto"

        acc_keys = ["auto", "gold", "cyan", "purple", "green", "coral"]
        acc_val = acc_keys[self.acc_combo.get_selected()]

        anim_val = self.anim_switch.get_active()
        compact_val = self.compact_switch.get_active()

        SETTINGS.set("default_view", view_val)
        SETTINGS.set("max_results", max_val)
        SETTINGS.set("confirm_actions", confirm_val)
        SETTINGS.set("check_updates_on_launch", updates_val)
        SETTINGS.set("aur_helper", aur_val)
        SETTINGS.set("pip_scope", pip_val)
        SETTINGS.set("preferred_terminal", term_val)
        SETTINGS.set("theme_accent", acc_val)
        SETTINGS.set("pacman_animation", anim_val)
        SETTINGS.set("compact_rows", compact_val)

        self.app.apply_settings()
        self.close()


class PacmangrGUI(Gtk.Application):
    def __init__(self) -> None:
        super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.DEFAULT_FLAGS)
        self.window: Gtk.ApplicationWindow | None = None
        self.tools = CORE.Tools.detect()
        self.cache = CORE.PackageCache()
        self.items: list = []
        self.raw_items: list = []
        self.current_item = None
        self.sources = source_choices(self.tools)
        self.request_id = 0
        self.operation_running = False
        self.package_activity: PacmanActivity | None = None
        self.operation_progress: Gtk.ProgressBar | None = None
        self.operation_progress_source = 0
        self.operation_started = 0.0
        self.operation_phase_started = 0.0
        self.operation_percent: int | None = None
        self.operation_speed = ""
        self.operation_eta = ""

        # State separation: Browse vs Installed
        self.view_mode = SETTINGS.get("default_view", "browse")
        self.browse_items: list = []
        self.browse_query: str = ""
        self.installed_filter_query: str = ""
        self.installed_kind_filter: str = "all"  # "all", "explicit", "dependency", "orphan"
        self.all_installed: list = []
        self.installed_items: list = []
        self.orphans_set: set[str] = set()
        self.explicit_set: set[str] = set()
        self.deps_set: set[str] = set()
        self.installed_loaded = False
        self.view_switcher_pairs: list[tuple[Gtk.Button, Gtk.Button]] = []

    def do_activate(self) -> None:
        if self.window:
            self.window.present()
            self._grab_search_focus()
            return

        ensure_graphical_auth_agent()
        install_css()
        self.window = Gtk.ApplicationWindow(application=self)
        self.window.set_title("pacmangr")
        self.window.set_default_size(1180, 760)
        self.window.set_size_request(840, 560)
        self.window.add_controller(self.make_escape_controller())

        self.build_header()
        self.build_content()
        self.window.present()

        # Switch to configured default view
        self.switch_view_mode(self.view_mode, initial=True)

        if SETTINGS.get("check_updates_on_launch", False):
            GLib.timeout_add(1500, self.check_updates_silently)

    def apply_settings(self) -> None:
        """Dynamically apply updated settings without restarting."""
        install_css(palette(), SETTINGS.get("compact_rows", False))
        if self.view_mode == "browse":
            if self.browse_items:
                self.show_items(self.browse_items, f"Results for “{self.browse_query}”", remember=False)
        else:
            self.filter_installed()
        self.set_status("Settings applied.")

    def build_header(self) -> None:
        assert self.window
        header = Gtk.HeaderBar()
        header.set_show_title_buttons(False)

        # A named settings action is easier to discover than an unlabeled gear.
        settings_button = Gtk.Button()
        settings_content = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=7)
        settings_content.append(Gtk.Image.new_from_icon_name("preferences-system-symbolic"))
        settings_button.set_child(settings_content)
        settings_button.set_tooltip_text("Settings (Ctrl+,)")
        settings_button.add_css_class("flat")
        settings_button.connect("clicked", lambda _button: self.open_settings_dialog())
        header.pack_end(settings_button)

        # Keep the titlebar focused on the app identity; views sit below it.
        brand = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        brand.append(PacmangrLogo(palette()))
        copy = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        title = Gtk.Label(label="pacmangr", xalign=0)
        title.add_css_class("title-label")
        tagline = Gtk.Label(label="packages, minus the maze", xalign=0)
        tagline.add_css_class("subtitle-label")
        copy.append(title)
        copy.append(tagline)
        brand.append(copy)
        header.set_title_widget(brand)
        self.window.set_titlebar(header)

    def make_escape_controller(self) -> Gtk.EventControllerKey:
        controller = Gtk.EventControllerKey()
        controller.connect("key-pressed", self.on_key_pressed)
        return controller

    def on_key_pressed(self, _controller, keyval, _keycode, state) -> bool:
        if keyval == Gdk.KEY_Escape and self.window:
            self.window.close()
            return True

        # Ctrl+Comma -> Settings
        if (state & Gdk.ModifierType.CONTROL_MASK) and (keyval in {Gdk.KEY_comma, Gdk.KEY_less}):
            self.open_settings_dialog()
            return True

        # Ctrl+1 -> Browse, Ctrl+2 -> Installed
        if (state & Gdk.ModifierType.CONTROL_MASK) and keyval == Gdk.KEY_1:
            self.switch_view_mode("browse")
            return True
        if (state & Gdk.ModifierType.CONTROL_MASK) and keyval == Gdk.KEY_2:
            self.switch_view_mode("installed")
            return True

        # Ctrl+F -> Focus active search bar
        if (state & Gdk.ModifierType.CONTROL_MASK) and keyval in {Gdk.KEY_f, Gdk.KEY_F}:
            self._grab_search_focus()
            return True

        # F5 -> Refresh
        if keyval == Gdk.KEY_F5:
            if self.view_mode == "installed":
                self.load_installed(force=True)
            elif self.browse_query:
                self.on_search(None)
            return True

        return False

    def _grab_search_focus(self) -> None:
        if self.view_mode == "browse" and hasattr(self, "search_entry"):
            self.search_entry.grab_focus()
        elif hasattr(self, "installed_filter_entry"):
            self.installed_filter_entry.grab_focus()

    def open_settings_dialog(self) -> None:
        dialog = SettingsDialog(self)
        dialog.present()

    def make_tools_button(self) -> Gtk.MenuButton:
        tools_button = Gtk.MenuButton(label="More")
        popover = Gtk.Popover()
        menu = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        menu.set_margin_top(8)
        menu.set_margin_bottom(8)
        menu.set_margin_start(8)
        menu.set_margin_end(8)

        for label, callback in (
            ("Settings", lambda _b: self.open_settings_dialog()),
            ("Check system updates", lambda _b: self.check_updates_dialog()),
            ("Update all package sources", self.confirm_update_all),
            ("Clean orphan packages", lambda _b: self.confirm_clean_orphans()),
            ("Refresh installed packages", lambda _b: self.load_installed(force=True)),
            ("Export package list", lambda _b: self.export_package_list()),
            ("Package manager status", self.show_manager_status),
            ("Cache information", self.show_cache_status),
            ("Clear local cache", self.confirm_clear_cache),
        ):
            button = Gtk.Button(label=label)
            button.set_halign(Gtk.Align.FILL)
            button.connect("clicked", callback)
            menu.append(button)
        popover.set_child(menu)
        tools_button.set_popover(popover)
        return tools_button

    def make_view_switcher(self) -> Gtk.Box:
        switcher = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=4)
        switcher.add_css_class("mode-switcher")
        browse = Gtk.Button(label="Browse & Install")
        browse.add_css_class("mode-button")
        browse.connect("clicked", lambda _button: self.switch_view_mode("browse"))
        installed = Gtk.Button(label="Installed")
        installed.add_css_class("mode-button")
        installed.connect("clicked", lambda _button: self.switch_view_mode("installed"))
        switcher.append(browse)
        switcher.append(installed)
        self.view_switcher_pairs.append((browse, installed))
        if len(self.view_switcher_pairs) == 1:
            self.tab_browse = browse
            self.tab_installed = installed
            self.installed_button = installed
        return switcher

    def build_content(self) -> None:
        assert self.window
        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        root.add_css_class("app-root")
        root.set_margin_top(14)
        root.set_margin_bottom(14)
        root.set_margin_start(14)
        root.set_margin_end(14)

        toolbar = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        toolbar.add_css_class("search-card")
        toolbar.add_css_class("hero-card")
        toolbar.set_hexpand(True)

        # --- BROWSE TOOLBAR INNER ---
        self.browse_toolbar = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=9)
        self.browse_toolbar.set_hexpand(True)
        self.browse_toolbar.set_margin_top(10)
        self.browse_toolbar.set_margin_bottom(10)
        self.browse_toolbar.set_margin_start(10)
        self.browse_toolbar.set_margin_end(10)

        browse_search_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        self.search_entry = Gtk.SearchEntry()
        self.search_entry.set_placeholder_text("Search packages, or find repositories on GitHub…")
        self.search_entry.set_hexpand(True)
        self.search_entry.connect("activate", self.on_search)
        browse_search_row.append(self.search_entry)

        self.search_button = Gtk.Button(label="Search packages")
        self.search_button.set_size_request(150, -1)
        self.search_button.add_css_class("suggested-action")
        self.search_button.connect("clicked", self.on_search)
        browse_search_row.append(self.search_button)
        self.browse_toolbar.append(browse_search_row)

        browse_filter_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        filter_label = Gtk.Label(label="SOURCE", xalign=0)
        filter_label.add_css_class("section-label")
        browse_filter_row.append(filter_label)

        self.source_dropdown = Gtk.DropDown.new_from_strings([label for label, _key in self.sources])
        self.source_dropdown.set_tooltip_text("Choose which package source to search")
        self.source_dropdown.set_size_request(190, -1)
        self.source_dropdown.connect("notify::selected", self.on_source_changed)
        browse_filter_row.append(self.source_dropdown)
        browse_filter_row.append(self.make_view_switcher())

        browse_spacer = Gtk.Box()
        browse_spacer.set_hexpand(True)
        browse_filter_row.append(browse_spacer)

        self.browse_spinner = Gtk.Spinner()
        self.browse_spinner.set_size_request(28, 28)
        browse_filter_row.append(self.browse_spinner)
        browse_filter_row.append(self.make_tools_button())
        self.browse_toolbar.append(browse_filter_row)
        toolbar.append(self.browse_toolbar)

        # --- INSTALLED TOOLBAR INNER ---
        self.installed_toolbar = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=9)
        self.installed_toolbar.set_hexpand(True)
        self.installed_toolbar.set_margin_top(10)
        self.installed_toolbar.set_margin_bottom(10)
        self.installed_toolbar.set_margin_start(10)
        self.installed_toolbar.set_margin_end(10)

        inst_search_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        self.installed_filter_entry = Gtk.SearchEntry()
        self.installed_filter_entry.set_placeholder_text("Filter installed packages by name, description, or tag…")
        self.installed_filter_entry.set_hexpand(True)
        self.installed_filter_entry.connect("search-changed", self.on_installed_filter_changed)
        inst_search_row.append(self.installed_filter_entry)

        self.installed_toolbar.append(inst_search_row)

        inst_action_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        inst_action_row.append(self.make_view_switcher())
        src_label2 = Gtk.Label(label="SOURCE", xalign=0)
        src_label2.add_css_class("section-label")
        inst_action_row.append(src_label2)

        self.installed_source_dropdown = Gtk.DropDown.new_from_strings([label for label, _key in self.sources])
        self.installed_source_dropdown.set_size_request(150, -1)
        self.installed_source_dropdown.connect("notify::selected", lambda _d, _p: self.filter_installed())
        inst_action_row.append(self.installed_source_dropdown)
        self.installed_kind_dropdown = Gtk.DropDown.new_from_strings(
            ["All packages", "Explicitly installed", "Dependencies", "Orphans"]
        )
        self.installed_kind_dropdown.set_tooltip_text("Filter installed packages by install reason")
        self.installed_kind_dropdown.set_size_request(150, -1)
        self.installed_kind_dropdown.connect("notify::selected", self.on_installed_kind_changed)
        inst_action_row.append(self.installed_kind_dropdown)

        inst_spacer = Gtk.Box()
        inst_spacer.set_hexpand(True)
        inst_action_row.append(inst_spacer)
        inst_action_row.append(self.make_tools_button())

        self.installed_spinner = Gtk.Spinner()
        self.installed_spinner.set_size_request(28, 28)
        inst_action_row.append(self.installed_spinner)
        self.installed_toolbar.append(inst_action_row)

        toolbar.append(self.installed_toolbar)
        root.append(toolbar)

        # Compatibility reference
        self.spinner = self.browse_spinner

        # --- CONTENT ROW (List + Detail) ---
        content_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        content_row.set_vexpand(True)

        list_card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        list_card.add_css_class("search-card")
        list_card.set_hexpand(True)
        list_card.set_vexpand(True)
        self.result_heading = Gtk.Label(label="Search for a package", xalign=0)
        self.result_heading.add_css_class("title-label")
        self.result_heading.set_margin_top(14)
        self.result_heading.set_margin_start(16)
        self.result_heading.set_margin_end(16)
        list_card.append(self.result_heading)

        self.result_list = Gtk.ListBox()
        self.result_list.set_selection_mode(Gtk.SelectionMode.SINGLE)
        self.result_list.connect("row-selected", self.on_row_selected)
        scroller = Gtk.ScrolledWindow()
        scroller.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        scroller.set_child(self.result_list)
        scroller.set_vexpand(True)
        list_card.append(scroller)
        content_row.append(list_card)

        # --- DETAIL CARD ---
        detail = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        detail.add_css_class("detail-card")
        detail.set_size_request(420, -1)
        detail.set_vexpand(True)
        self.detail_card = detail

        self.detail_name = Gtk.Label(label="Select a package", xalign=0)
        self.detail_name.set_wrap(True)
        self.detail_name.set_halign(Gtk.Align.CENTER)
        self.detail_name.set_xalign(0.5)
        self.detail_name.add_css_class("title-label")
        self.detail_name.set_margin_top(140)
        self.detail_name.set_margin_start(18)
        self.detail_name.set_margin_end(18)
        detail.append(self.detail_name)

        self.detail_meta = Gtk.Label(label="Package details appear here.", xalign=0)
        self.detail_meta.set_wrap(True)
        self.detail_meta.set_halign(Gtk.Align.CENTER)
        self.detail_meta.set_xalign(0.5)
        self.detail_meta.add_css_class("muted")
        self.detail_meta.set_margin_start(18)
        self.detail_meta.set_margin_end(18)
        detail.append(self.detail_meta)

        detail_scroller = Gtk.ScrolledWindow()
        detail_scroller.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        detail_scroller.set_vexpand(True)
        detail_scroller.set_margin_start(18)
        detail_scroller.set_margin_end(18)
        self.detail_text = Gtk.TextView()
        self.detail_text.set_editable(False)
        self.detail_text.set_cursor_visible(False)
        self.detail_text.set_wrap_mode(Gtk.WrapMode.WORD_CHAR)
        self.detail_text.set_top_margin(4)
        self.detail_text.set_bottom_margin(4)
        detail_scroller.set_child(self.detail_text)
        detail.append(detail_scroller)

        # Actions Grid
        actions = Gtk.Grid(column_spacing=8, row_spacing=8)
        actions.set_margin_start(18)
        actions.set_margin_end(18)
        actions.set_margin_bottom(18)
        actions.set_visible(False)
        self.detail_actions = actions

        # Row 0: Info, Versions, Files, Copy Name
        self.info_button = Gtk.Button(label="Details")
        self.info_button.set_sensitive(False)
        self.info_button.connect("clicked", self.on_info)
        self.info_button.set_hexpand(True)
        actions.attach(self.info_button, 0, 0, 1, 1)

        self.versions_button = Gtk.Button(label="Versions")
        self.versions_button.set_sensitive(False)
        self.versions_button.connect("clicked", self.on_versions)
        self.versions_button.set_hexpand(True)
        actions.attach(self.versions_button, 1, 0, 1, 1)

        self.files_button = Gtk.Button(label="Files")
        self.files_button.set_sensitive(False)
        self.files_button.connect("clicked", self.on_package_files)
        self.files_button.set_hexpand(True)
        actions.attach(self.files_button, 2, 0, 1, 1)

        self.copy_button = Gtk.Button(label="Copy Name")
        self.copy_button.set_sensitive(False)
        self.copy_button.connect("clicked", self.on_copy_name)
        self.copy_button.set_hexpand(True)
        actions.attach(self.copy_button, 3, 0, 1, 1)

        # Row 1: Install/Reinstall, Remove, Website
        self.install_button = Gtk.Button(label="Install")
        self.install_button.add_css_class("suggested-action")
        self.install_button.set_sensitive(False)
        self.install_button.connect("clicked", lambda _button: self.confirm_action("install"))
        self.install_button.set_hexpand(True)
        actions.attach(self.install_button, 0, 1, 2, 1)

        self.remove_button = Gtk.Button(label="Remove")
        self.remove_button.add_css_class("danger")
        self.remove_button.set_sensitive(False)
        self.remove_button.connect("clicked", lambda _button: self.confirm_action("remove"))
        self.remove_button.set_hexpand(True)
        actions.attach(self.remove_button, 2, 1, 1, 1)

        self.website_button = Gtk.Button(label="Website")
        self.website_button.set_sensitive(False)
        self.website_button.connect("clicked", self.on_open_website)
        self.website_button.set_hexpand(True)
        actions.attach(self.website_button, 3, 1, 1, 1)

        detail.append(actions)
        content_row.append(detail)
        root.append(content_row)

        # --- STATUS BAR ---
        status_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        status_box.add_css_class("status-card")
        self.package_activity = PacmanActivity(palette())
        self.package_activity.set_margin_start(10)
        self.package_activity.set_valign(Gtk.Align.CENTER)
        status_box.append(self.package_activity)

        status_content = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        status_content.set_hexpand(True)
        self.status_label = Gtk.Label(
            label=f"Ready · {len(self.sources) - 1} package sources detected",
            xalign=0,
        )
        self.status_label.set_ellipsize(3)
        self.status_label.set_hexpand(True)
        self.status_label.set_margin_top(8)
        self.status_label.set_margin_bottom(8)
        self.status_label.set_margin_start(12)
        self.status_label.set_margin_end(12)
        status_content.append(self.status_label)

        self.operation_progress = Gtk.ProgressBar()
        self.operation_progress.set_show_text(True)
        self.operation_progress.set_hexpand(True)
        self.operation_progress.set_margin_start(12)
        self.operation_progress.set_margin_end(12)
        self.operation_progress.set_margin_bottom(8)
        self.operation_progress.set_visible(False)
        status_content.append(self.operation_progress)
        status_box.append(status_content)
        root.append(status_box)

        self.window.set_child(root)

    def switch_view_mode(self, mode: str, initial: bool = False) -> None:
        """Switch between 'browse' (to install) and 'installed' modes."""
        self.view_mode = mode
        for browse, installed in self.view_switcher_pairs:
            browse.add_css_class("active" if mode == "browse" else "inactive")
            browse.remove_css_class("inactive" if mode == "browse" else "active")
            installed.add_css_class("active" if mode == "installed" else "inactive")
            installed.remove_css_class("inactive" if mode == "installed" else "active")
        if mode == "browse":
            self.browse_toolbar.set_visible(True)
            self.installed_toolbar.set_visible(False)
            self.spinner = self.browse_spinner
            if self.browse_items:
                self.show_items(self.browse_items, f"Results for “{self.browse_query}”", remember=False)
            elif not initial:
                self.clear_rows()
                self.result_heading.set_text("Search for packages")
                self.set_status("Ready · type a package name above to search.")
            self.search_entry.grab_focus()
        else:
            self.browse_toolbar.set_visible(False)
            self.installed_toolbar.set_visible(True)
            self.spinner = self.installed_spinner
            if not self.installed_loaded:
                self.load_installed()
            else:
                self.filter_installed()
            self.installed_filter_entry.grab_focus()

    def set_installed_kind_filter(self, kind: str) -> None:
        self.installed_kind_filter = kind
        kinds = ("all", "explicit", "dependency", "orphan")
        if hasattr(self, "installed_kind_dropdown") and kind in kinds:
            self.installed_kind_dropdown.set_selected(kinds.index(kind))
        self.filter_installed()

    def on_installed_kind_changed(self, dropdown, _param) -> None:
        kinds = ("all", "explicit", "dependency", "orphan")
        selected = min(dropdown.get_selected(), len(kinds) - 1)
        self.installed_kind_filter = kinds[selected]
        self.filter_installed()

    def on_installed_filter_changed(self, entry: Gtk.SearchEntry) -> None:
        self.installed_filter_query = entry.get_text().strip().lower()
        self.filter_installed()

    def filter_installed(self) -> None:
        if not self.all_installed:
            return

        query = self.installed_filter_query
        kind = self.installed_kind_filter
        selected_src_idx = min(self.installed_source_dropdown.get_selected(), len(self.sources) - 1)
        source = self.sources[selected_src_idx][1]

        filtered = []
        for item in self.all_installed:
            if source != "all" and not self.source_matches(item, source):
                continue

            # Kind matching
            if kind == "orphan" and not getattr(item, "is_orphan", False):
                continue
            if kind == "explicit" and getattr(item, "install_reason", "") != "explicit":
                continue
            if kind == "dependency" and getattr(item, "install_reason", "") != "dependency":
                continue

            # Query matching
            if query:
                haystack = f"{item.name} {item.package_id} {item.description or ''}".lower()
                if query not in haystack:
                    continue

            filtered.append(item)

        self.installed_items = filtered
        label = self.sources[selected_src_idx][0]
        heading_parts = ["Installed packages"]
        if source != "all":
            heading_parts.append(f"from {label}")
        if kind != "all":
            heading_parts.append(f"({kind} only)")
        heading = " · ".join(heading_parts)

        self.show_items(filtered, heading, remember=False)
        self.set_status(f"{len(filtered)} installed packages matching filter.")

    def load_installed(self, force: bool = False) -> None:
        self.set_status("Scanning installed packages…", busy=True)
        cached = self.cache.load_installed() if not force else None
        if cached:
            self._apply_installed_data(cached)

        def worker() -> None:
            try:
                # Classify arch packages
                explicit = set()
                deps = set()
                orphans = set()
                try:
                    if shutil.which("pacman"):
                        out_exp = subprocess.check_output(["pacman", "-Qeq"], text=True, stderr=subprocess.DEVNULL)
                        explicit = {line.strip() for line in out_exp.splitlines() if line.strip()}
                        out_dep = subprocess.check_output(["pacman", "-Qdq"], text=True, stderr=subprocess.DEVNULL)
                        deps = {line.strip() for line in out_dep.splitlines() if line.strip()}
                        out_orph = subprocess.check_output(["pacman", "-Qtdq"], text=True, stderr=subprocess.DEVNULL)
                        orphans = {line.strip() for line in out_orph.splitlines() if line.strip()}
                except Exception:
                    pass

                items = CORE.collect_installed_packages(self.tools)
                for item in items:
                    name = item.name
                    if name in orphans:
                        item.is_orphan = True
                        item.install_reason = "orphan"
                    elif name in explicit:
                        item.is_orphan = False
                        item.install_reason = "explicit"
                    elif name in deps:
                        item.is_orphan = False
                        item.install_reason = "dependency"
                    else:
                        item.is_orphan = False
                        item.install_reason = "unknown"

                self.cache.save_installed(items)
                GLib.idle_add(self._finish_load_installed, items, explicit, deps, orphans, "")
            except Exception as exc:
                GLib.idle_add(self._finish_load_installed, [], set(), set(), set(), str(exc))

        threading.Thread(target=worker, daemon=True).start()

    def _apply_installed_data(self, items: list) -> None:
        self.all_installed = list(items)
        self.installed_loaded = True
        self.filter_installed()

    def _finish_load_installed(self, items: list, explicit: set, deps: set, orphans: set, error: str) -> bool:
        if error:
            self.set_status(f"Installed packages scan failed: {error}")
            return False

        self.explicit_set = explicit
        self.deps_set = deps
        self.orphans_set = orphans
        self.all_installed = items
        self.installed_loaded = True

        self.filter_installed()
        return False

    def confirm_clean_orphans(self) -> None:
        if not self.orphans_set:
            self.set_status("No orphan packages detected.")
            return

        orphan_list = sorted(self.orphans_set)
        detail = (
            f"The following {len(orphan_list)} unused packages will be safely removed:\n\n"
            + "\n".join(f"• {pkg}" for pkg in orphan_list[:30])
        )
        if len(orphan_list) > 30:
            detail += f"\n...and {len(orphan_list) - 30} more."

        dialog = Gtk.AlertDialog()
        dialog.set_message(f"Remove {len(orphan_list)} orphaned packages?")
        dialog.set_detail(detail)
        dialog.set_buttons(["Cancel", "Remove Orphans"])
        dialog.set_cancel_button(0)
        dialog.set_default_button(1)

        def finished(alert: Gtk.AlertDialog, result) -> None:
            try:
                response = alert.choose_finish(result)
            except GLib.Error:
                return
            if response == 1:
                cmd = ["/usr/bin/sudo", "/usr/bin/pacman", "-Rns", *orphan_list]
                self.launch_raw_operation("Remove orphans", cmd, on_done=lambda: self.load_installed(force=True))

        dialog.choose(self.window, None, finished)

    def check_updates_silently(self) -> bool:
        def worker() -> None:
            count = self._run_checkupdates()
            if count > 0:
                GLib.idle_add(self.set_status, f"🔔 {count} package updates are available.")
        threading.Thread(target=worker, daemon=True).start()
        return GLib.SOURCE_REMOVE

    def check_updates_dialog(self) -> None:
        self.set_status("Checking for updates…", busy=True)

        def worker() -> None:
            lines = self._get_checkupdates_lines()
            GLib.idle_add(self._show_updates_dialog, lines)

        threading.Thread(target=worker, daemon=True).start()

    def _run_checkupdates(self) -> int:
        try:
            if shutil.which("checkupdates"):
                out = subprocess.check_output(["checkupdates"], text=True, timeout=25, stderr=subprocess.DEVNULL)
                return len([l for l in out.splitlines() if l.strip()])
        except Exception:
            pass
        return 0

    def _get_checkupdates_lines(self) -> list[str]:
        try:
            if shutil.which("checkupdates"):
                out = subprocess.check_output(["checkupdates"], text=True, timeout=25, stderr=subprocess.DEVNULL)
                return [l.strip() for l in out.splitlines() if l.strip()]
        except Exception:
            pass
        return []

    def _show_updates_dialog(self, lines: list[str]) -> bool:
        self.set_status("Update check completed.")
        if not lines:
            self.show_text_dialog("System Up to Date", "All packages are up to date! No updates available.")
            return False

        detail = f"{len(lines)} updates available:\n\n" + "\n".join(lines[:40])
        if len(lines) > 40:
            detail += f"\n...and {len(lines) - 40} more."

        dialog = Gtk.AlertDialog()
        dialog.set_message(f"{len(lines)} Package Updates Available")
        dialog.set_detail(detail)
        dialog.set_buttons(["Later", "Update All Packages"])
        dialog.set_cancel_button(0)
        dialog.set_default_button(1)

        def finished(alert: Gtk.AlertDialog, result) -> None:
            try:
                response = alert.choose_finish(result)
            except GLib.Error:
                return
            if response == 1:
                self.confirm_update_all(None)

        dialog.choose(self.window, None, finished)
        return False

    def export_package_list(self) -> None:
        if not self.all_installed:
            self.set_status("No installed packages loaded to export.")
            return

        export_path = Path.home() / "pacmangr-installed-packages.txt"
        try:
            lines = [
                f"# pacmangr package export - {time.strftime('%Y-%m-%d %H:%M:%S')}",
                f"# Total packages: {len(self.all_installed)}",
                "",
            ]
            for item in sorted(self.all_installed, key=lambda x: x.name):
                reason = f" [{item.install_reason}]" if hasattr(item, "install_reason") else ""
                lines.append(f"{item.name} {item.version} ({item.source}){reason}")
            export_path.write_text("\n".join(lines), encoding="utf-8")
            self.set_status(f"Exported package list to {export_path}")
            self.show_text_dialog(
                "Export Successful",
                f"Exported {len(self.all_installed)} installed packages to:\n{export_path}",
            )
        except Exception as exc:
            self.set_status(f"Export failed: {exc}")

    def on_package_files(self, _button) -> None:
        item = self.current_item
        if not item:
            return

        self.set_status(f"Listing installed files for {item.title()}…", busy=True)

        def worker() -> None:
            try:
                if shutil.which("pacman") and item.source in {"pacman", "aur", "aur/local"}:
                    out = subprocess.check_output(["pacman", "-Ql", item.name], text=True, stderr=subprocess.STDOUT)
                else:
                    out = f"File listing is not supported for {item.source} packages."
                GLib.idle_add(self._finish_package_files, item, out)
            except subprocess.CalledProcessError as err:
                GLib.idle_add(self._finish_package_files, item, f"Could not list files: {err.output}")
            except Exception as exc:
                GLib.idle_add(self._finish_package_files, item, f"Error: {exc}")

        threading.Thread(target=worker, daemon=True).start()

    def _finish_package_files(self, item, output: str) -> bool:
        if self.current_item is not item:
            return False
        self.detail_text.get_buffer().set_text(output.strip() or "No files found.")
        self.set_status(f"Loaded files for {item.title()}.")
        return False

    def on_copy_name(self, _button) -> None:
        if not self.current_item:
            return
        name = self.current_item.name
        display = Gdk.Display.get_default()
        if display:
            display.get_clipboard().set(name)
            self.set_status(f"Copied '{name}' to clipboard.")

    def on_open_website(self, _button) -> None:
        item = self.current_item
        if not item or not self.window:
            return

        def worker() -> None:
            url = ""
            if item.origin and (item.origin.startswith("http://") or item.origin.startswith("https://")):
                url = item.origin
            elif shutil.which("pacman") and item.source in {"pacman", "aur", "aur/local"}:
                try:
                    out = subprocess.check_output(["pacman", "-Qi", item.name], text=True, stderr=subprocess.DEVNULL)
                    for line in out.splitlines():
                        if line.startswith("URL"):
                            parts = line.split(":", 1)
                            if len(parts) > 1:
                                url = parts[1].strip()
                                break
                except Exception:
                    pass

            if not url:
                if item.source in {"aur", "aur/local"}:
                    url = f"https://aur.archlinux.org/packages/{item.name}"
                else:
                    url = f"https://archlinux.org/packages/?q={item.name}"

            GLib.idle_add(self._launch_url, url)

        threading.Thread(target=worker, daemon=True).start()

    def _launch_url(self, url: str) -> bool:
        if url:
            Gtk.show_uri(self.window, url, Gdk.CURRENT_TIME)
            self.set_status(f"Opened {url}")
        return False

    def launch_raw_operation(self, title: str, cmd: list[str], on_done=None) -> None:
        if self.operation_running:
            self.set_status("Another package operation is already running.")
            return

        try:
            argv = prepare_gui_operation(cmd, self.tools, "remove", shutil.which("pkexec"))
        except RuntimeError as exc:
            self.set_status(str(exc))
            return

        self.operation_running = True
        if self.package_activity:
            self.package_activity.start("remove")
        self.start_operation_progress()
        self.set_status(f"{title} in progress…", busy=True)

        def worker() -> None:
            env = os.environ.copy()
            env.update({"DEBIAN_FRONTEND": "noninteractive", "LC_ALL": "C"})
            try:
                code, output = run_streamed_operation(
                    argv,
                    env=env,
                    on_line=lambda line: GLib.idle_add(self.update_operation_progress, line),
                )
            except OSError as exc:
                code, output = 126, str(exc)

            def done() -> bool:
                self.operation_running = False
                if self.package_activity:
                    self.package_activity.stop()
                self.stop_operation_progress()
                self.detail_text.get_buffer().set_text(output or "Operation completed.")
                self.set_status(f"{title} completed." if code == 0 else f"{title} failed with code {code}.")
                if on_done and code == 0:
                    on_done()
                return False

            GLib.idle_add(done)

        threading.Thread(target=worker, daemon=True).start()

    def set_status(self, text: str, busy: bool = False) -> None:
        self.status_label.set_text(text)
        if busy:
            self.spinner.start()
        else:
            self.spinner.stop()

    def clear_rows(self) -> None:
        while child := self.result_list.get_first_child():
            self.result_list.remove(child)

    def start_operation_progress(self) -> None:
        self.operation_started = time.monotonic()
        self.operation_phase_started = self.operation_started
        self.operation_percent = None
        self.operation_speed = ""
        self.operation_eta = ""
        if self.operation_progress:
            self.operation_progress.set_fraction(0)
            self.operation_progress.set_text("Starting package manager…")
            self.operation_progress.set_visible(True)
        if not self.operation_progress_source:
            self.operation_progress_source = GLib.timeout_add(
                200,
                self.tick_operation_progress,
            )

    def stop_operation_progress(self) -> None:
        if self.operation_progress_source:
            GLib.source_remove(self.operation_progress_source)
            self.operation_progress_source = 0
        if self.operation_progress:
            self.operation_progress.set_visible(False)

    def tick_operation_progress(self) -> bool:
        if not self.operation_running:
            self.operation_progress_source = 0
            return GLib.SOURCE_REMOVE
        self.render_operation_progress()
        return GLib.SOURCE_CONTINUE

    def render_operation_progress(self) -> None:
        if not self.operation_progress:
            return
        if self.operation_percent is None:
            self.operation_progress.pulse()
            parts = ["Downloading · measuring progress"]
            if self.operation_speed:
                parts.append(self.operation_speed)
            if self.operation_eta:
                parts.append(f"ETA {self.operation_eta}")
            self.operation_progress.set_text(" · ".join(parts))
            return

        percent = max(0, min(100, self.operation_percent))
        self.operation_progress.set_fraction(percent / 100)
        eta = self.operation_eta
        if not eta and 0 < percent < 100:
            elapsed = time.monotonic() - self.operation_phase_started
            eta = format_eta(elapsed * (100 - percent) / percent)
        parts = [f"{percent}%"]
        if self.operation_speed:
            parts.append(self.operation_speed)
        parts.append(f"ETA {eta or 'calculating…'}")
        self.operation_progress.set_text(" · ".join(parts))

    def update_operation_progress(self, raw_line: str) -> bool:
        if not self.operation_running:
            return False
        _line, percent, speed, eta = parse_operation_progress(raw_line)
        if percent is not None:
            if (
                self.operation_percent is None
                or percent + 10 < self.operation_percent
            ):
                self.operation_phase_started = time.monotonic()
                self.operation_eta = ""
            self.operation_percent = percent
        if speed:
            self.operation_speed = speed
        if eta:
            self.operation_eta = eta
        self.render_operation_progress()
        return False

    def selected_source(self) -> str:
        selected = min(self.source_dropdown.get_selected(), len(self.sources) - 1)
        return self.sources[selected][1]

    def source_matches(self, item, source: str) -> bool:
        if source == "all":
            return True
        if source in {"yay", "paru"}:
            return item.manager == source or item.source in {source, "aur", "aur/local"}
        return item.source == source or item.manager == source

    def on_source_changed(self, _dropdown, _param) -> None:
        if not hasattr(self, "search_entry"):
            return
        self.search_entry.set_placeholder_text(
            "Search GitHub repositories by name, topic, or description"
            if self.selected_source() == "github"
            else "Paste an HTTPS, SSH, or git@ repository URL"
            if self.selected_source() == "git"
            else "Search packages across your enabled sources…"
        )
        if hasattr(self, "search_button"):
            self.search_button.set_label(
                "Search GitHub" if self.selected_source() == "github" else "Search packages"
            )
        if self.browse_query:
            self.on_search(self.source_dropdown)

    def show_items(self, items: list, heading: str, *, remember: bool = True) -> None:
        max_r = int(SETTINGS.get("max_results", MAX_GUI_RESULTS))
        if remember:
            self.raw_items = list(items)
        self.items = items[:max_r]
        self.current_item = None
        self.clear_rows()
        self.result_heading.set_text(heading)
        for item in self.items:
            self.result_list.append(PackageRow(item, compact=self.view_mode == "installed"))
        self.detail_name.set_text("Select a package")
        self.detail_name.set_halign(Gtk.Align.CENTER)
        self.detail_name.set_xalign(0.5)
        self.detail_name.set_margin_top(140)
        self.detail_meta.set_text("Package details appear here.")
        self.detail_meta.set_halign(Gtk.Align.CENTER)
        self.detail_meta.set_xalign(0.5)
        self.detail_text.get_buffer().set_text("")
        self.info_button.set_sensitive(False)
        self.versions_button.set_sensitive(False)
        self.files_button.set_sensitive(False)
        self.copy_button.set_sensitive(False)
        self.website_button.set_sensitive(False)
        self.install_button.set_sensitive(False)
        self.remove_button.set_sensitive(False)
        self.detail_actions.set_visible(False)

    def refresh_installed(self, _widget=None) -> None:
        self.switch_view_mode("installed")
        self.load_installed(force=True)

    def on_installed_toggled(self, button) -> None:
        """Backward-compatible handler for installed button."""
        self.switch_view_mode("installed")

    def show_text_dialog(self, title: str, detail: str) -> None:
        if not self.window:
            return
        dialog = Gtk.AlertDialog()
        dialog.set_message(title)
        dialog.set_detail(detail)
        dialog.set_buttons(["Close"])
        dialog.set_default_button(0)
        dialog.set_cancel_button(0)
        dialog.choose(self.window, None, lambda alert, result: alert.choose_finish(result))

    def show_manager_status(self, _widget=None) -> None:
        lines = []
        for label, key in self.sources[1:]:
            if key == "appimage":
                lines.append(f"{label}\nLocal files in Applications folders")
                continue
            if key == "github":
                lines.append(f"{label}\nGitHub repository search (internet required)")
                continue
            path = None
            if key in {"pacman", "yay", "paru", "flatpak", "apt", "snap", "git"}:
                attr = "apt_cache" if key == "apt" else key
                path = getattr(self.tools, attr, None)
            else:
                path = self.tools.extra_managers.get(key)
            lines.append(f"{label}\n{path or 'not detected'}")
        lines.append("\nNix note\nProfile and nix-env packages are managed when their CLI is detected; declarative system or Home Manager files are never rewritten behind your back.")
        self.show_text_dialog("Package manager status", "\n\n".join(lines))

    def show_cache_status(self, _widget=None) -> None:
        self.show_text_dialog("Local package cache", cache_summary(self.cache))

    def confirm_clear_cache(self, _widget=None) -> None:
        if not self.window:
            return
        dialog = Gtk.AlertDialog()
        dialog.set_message("Clear Pacmangr's local cache?")
        dialog.set_detail("Only cached search, installed-package, and version metadata is removed. No packages are changed.")
        dialog.set_buttons(["Cancel", "Clear cache"])
        dialog.set_cancel_button(0)
        dialog.set_default_button(1)

        def finished(alert: Gtk.AlertDialog, result) -> None:
            try:
                response = alert.choose_finish(result)
            except GLib.Error:
                return
            if response != 1:
                return
            removed = False
            for path in (self.cache.path, Path(f"{self.cache.path}-wal"), Path(f"{self.cache.path}-shm")):
                try:
                    path.unlink()
                    removed = True
                except FileNotFoundError:
                    pass
            self.set_status("Local cache cleared." if removed else "Local cache was already empty.")

        dialog.choose(self.window, None, finished)

    def on_search(self, _widget) -> None:
        query = self.search_entry.get_text().strip()
        if not query:
            self.set_status("Type a package name first.")
            self.search_entry.grab_focus()
            return

        self.browse_query = query
        self.request_id += 1
        request_id = self.request_id
        backend = self.selected_source()
        if backend == "github":
            self.set_status(f"Searching GitHub for {query!r}…", busy=True)

            def github_worker() -> None:
                try:
                    params = urllib.parse.urlencode(
                        {"q": query, "sort": "stars", "order": "desc", "per_page": 30}
                    )
                    request = urllib.request.Request(
                        f"https://api.github.com/search/repositories?{params}",
                        headers={
                            "Accept": "application/vnd.github+json",
                            "User-Agent": "Pacmangr-GUI",
                        },
                    )
                    with urllib.request.urlopen(request, timeout=15) as response:
                        payload = json.loads(response.read().decode("utf-8"))

                    results = []
                    for repository in payload.get("items", []):
                        item = CORE.git_package(repository.get("clone_url", ""))
                        if item is None:
                            continue
                        item.name = repository.get("full_name") or item.name
                        item.repo = item.name
                        description = repository.get("description") or "No description provided."
                        stars = repository.get("stargazers_count", 0)
                        language = repository.get("language")
                        item.description = f"{description}\n\n★ {stars:,} stars"
                        if language:
                            item.description += f" · {language}"
                        item.description += (
                            "\nClone stores the checkout in Pacmangr's managed Git directory. "
                            "Repository build scripts are not run automatically."
                        )
                        results.append(item)
                    GLib.idle_add(self.finish_search, request_id, query, results, "")
                except Exception as exc:
                    GLib.idle_add(
                        self.finish_search,
                        request_id,
                        query,
                        [],
                        f"GitHub search failed: {exc}",
                    )

            threading.Thread(target=github_worker, daemon=True).start()
            return

        if backend == "all" and CORE.is_git_url(query):
            backend = "git"
        source_label = self.sources[self.source_dropdown.get_selected()][0]
        if backend == "git":
            source_label = "Git repository"
        self.set_status(f"Searching {source_label.lower()} for {query!r}…", busy=True)

        cached_engine = CORE.headless_ui()
        managers = cached_engine.enabled_search_managers(backend)
        cached = cached_engine.cache.load_search(query, managers)
        if cached:
            cached = cached_engine.rank_results(cached_engine.dedupe_items(cached), query)
            self.browse_items = cached
            self.show_items(cached, f"Results for “{query}” · refreshing")

        def worker() -> None:
            try:
                engine = CORE.headless_ui()
                results = engine.search_packages(query, backend)
                GLib.idle_add(self.finish_search, request_id, query, results, "")
            except Exception as exc:
                GLib.idle_add(self.finish_search, request_id, query, [], str(exc))

        threading.Thread(target=worker, daemon=True).start()

    def finish_search(self, request_id: int, query: str, items: list, error: str) -> bool:
        if request_id != self.request_id or self.view_mode != "browse":
            return False
        if error:
            self.set_status(f"Search failed: {error}")
            return False
        self.browse_items = items
        self.show_items(items, f"Results for “{query}”")
        max_r = int(SETTINGS.get("max_results", MAX_GUI_RESULTS))
        suffix = f" · showing first {max_r}" if len(items) > max_r else ""
        noun = "repositories" if self.selected_source() == "github" else "packages"
        self.set_status(f"Found {len(items)} {noun}{suffix}.")
        return False

    def on_row_selected(self, _listbox, row: PackageRow | None) -> None:
        if row is None:
            return
        item = row.item
        self.current_item = item
        self.detail_actions.set_visible(True)
        self.detail_name.set_text(item.title())
        self.detail_name.set_halign(Gtk.Align.START)
        self.detail_name.set_xalign(0.0)
        self.detail_name.set_margin_top(16)
        self.detail_meta.set_halign(Gtk.Align.START)
        self.detail_meta.set_xalign(0.0)

        state = "installed" if item.installed else "available to install"
        if getattr(item, "is_orphan", False):
            state = "installed (unused orphan)"
        elif getattr(item, "install_reason", "") == "explicit":
            state = "installed explicitly"
        elif getattr(item, "install_reason", "") == "dependency":
            state = "installed as dependency"

        meta = [
            f"source: {item.source} · {state}",
            f"package: {item.package_id}",
            f"version: {item.version or 'unknown'}",
        ]
        if item.repo:
            meta.append(f"repository: {item.repo}")
        self.detail_meta.set_text("\n".join(meta))
        description = item.description or "No description available."
        if item.source == "nix" or item.manager == "nix":
            description += "\n\nPacmangr changes only your imperative Nix profile. Declarative NixOS or Home Manager files are left untouched."
        self.detail_text.get_buffer().set_text(description)
        self.info_button.set_sensitive(True)
        self.versions_button.set_sensitive(item.source in {"pacman", "aur", "aur/local", "apt"} or item.manager in {"pacman", "yay", "paru"})
        self.files_button.set_sensitive(item.installed)
        self.copy_button.set_sensitive(True)
        self.website_button.set_sensitive(True)
        self.install_button.set_label("Reinstall" if item.installed else "Install")
        if item.source == "git":
            self.install_button.set_label("Update checkout" if item.installed else "Clone repository")
        self.install_button.set_sensitive(
            item.source != "appimage" and (item.source != "git" or bool(self.tools.git))
        )
        self.remove_button.set_sensitive((item.installed or item.source == "appimage") and item.source != "git")

    def on_info(self, _button) -> None:
        item = self.current_item
        if not item:
            return
        command = item.info_command(self.tools, self.view_mode == "installed" or item.installed)
        if not command:
            self.set_status(f"No details command is available for {item.title()}.")
            return
        self.set_status(f"Loading details for {item.title()}…", busy=True)

        def worker() -> None:
            code, output = CORE.run_capture(command, timeout=30)
            GLib.idle_add(self.finish_info, item, code, output)

        threading.Thread(target=worker, daemon=True).start()

    def finish_info(self, item, code: int, output: str) -> bool:
        if self.current_item is not item:
            return False
        text = output.strip() or f"Details command exited {code} without output."
        self.detail_text.get_buffer().set_text(text)
        self.set_status(
            f"Loaded details for {item.title()}." if code == 0
            else f"Details command exited {code}."
        )
        return False

    def on_versions(self, _button) -> None:
        item = self.current_item
        if not item:
            return
        manager = item.manager or item.source
        cached = self.cache.load_versions(manager, item.package_id)
        if cached:
            self.detail_text.get_buffer().set_text(CORE.format_versions(item.package_id, cached))
        self.set_status(f"Checking versions for {item.title()}…", busy=True)

        def worker() -> None:
            try:
                versions = CORE.package_versions(self.tools, item)
                if versions:
                    self.cache.save_versions(manager, item.package_id, versions)
                GLib.idle_add(self.finish_versions, item, versions, "")
            except Exception as exc:
                GLib.idle_add(self.finish_versions, item, [], str(exc))

        threading.Thread(target=worker, daemon=True).start()

    def finish_versions(self, item, versions: list, error: str) -> bool:
        if self.current_item is not item:
            return False
        if error:
            self.set_status(f"Version check failed: {error}")
            return False
        self.detail_text.get_buffer().set_text(CORE.format_versions(item.package_id, versions))
        self.set_status(f"Found {len(versions)} versions for {item.title()}.")
        return False

    def confirm_update_all(self, _button=None) -> None:
        if not self.window:
            return
        commands = CORE.system_update_commands(self.tools)
        if not commands:
            self.set_status("No update-capable package manager was detected.")
            return
        detail = "The following native package managers will run in order:\n\n" + "\n".join(
            f"• {label}: {shlex.join(command)}" for label, command in commands
        )
        dialog = Gtk.AlertDialog()
        dialog.set_message("Update all package sources?")
        dialog.set_detail(detail)
        dialog.set_buttons(["Cancel", "Update all"])
        dialog.set_cancel_button(0)
        dialog.set_default_button(1)

        def finished(alert: Gtk.AlertDialog, result) -> None:
            try:
                response = alert.choose_finish(result)
            except GLib.Error:
                return
            if response == 1:
                self.launch_maintenance(commands)

        dialog.choose(self.window, None, finished)

    def launch_maintenance(self, commands: list[tuple[str, list[str]]]) -> None:
        if self.operation_running:
            self.set_status("Another package operation is already running.")
            return
        prepared: list[tuple[str, list[str]]] = []
        try:
            for label, command in commands:
                prepared.append((label, prepare_gui_operation(command, self.tools, "update", shutil.which("pkexec"))))
        except RuntimeError as exc:
            self.set_status(str(exc))
            return
        self.operation_running = True
        self.install_button.set_sensitive(False)
        self.remove_button.set_sensitive(False)
        if self.package_activity:
            self.package_activity.start("update")
        self.start_operation_progress()
        self.set_status(f"Updating {len(prepared)} package sources…", busy=True)

        def worker() -> None:
            outputs: list[str] = []
            code = 0
            env = os.environ.copy()
            env.update({"DEBIAN_FRONTEND": "noninteractive", "LC_ALL": "C"})
            env.setdefault("TERM", "xterm-256color")
            for label, argv in prepared:
                GLib.idle_add(self.set_status, f"Updating {label}…", True)
                try:
                    code, output = run_streamed_operation(
                        argv,
                        env,
                        lambda line: GLib.idle_add(self.update_operation_progress, line),
                    )
                except OSError as exc:
                    code, output = 126, f"Could not start {label}: {exc}"
                outputs.append(f"[{label}]\n{output.strip()}")
                if code != 0:
                    break
            GLib.idle_add(self.finish_maintenance, code, "\n\n".join(outputs))

        threading.Thread(target=worker, daemon=True).start()

    def finish_maintenance(self, code: int, output: str) -> bool:
        self.operation_running = False
        if self.package_activity:
            self.package_activity.stop()
        self.stop_operation_progress()
        self.detail_text.get_buffer().set_text(output or "No package-manager output.")
        self.set_status("All package updates completed." if code == 0 else f"Package update stopped with status {code}.")
        if code == 0 and self.installed_loaded:
            self.load_installed(force=True)
        return False

    def confirm_action(self, action: str, install_scope: str | None = None) -> None:
        item = self.current_item
        if not item or not self.window:
            return
        if action == "install" and (item.source == "pip" or item.manager == "pip") and install_scope is None:
            self.choose_pip_scope(item)
            return

        scope = install_scope or SETTINGS.get("pip_scope", "venv")
        command = (
            item.install_command(self.tools, install_scope=scope)
            if action == "install"
            else item.remove_command(self.tools)
        )
        if not command:
            self.set_status(f"No {action} command is available for {item.title()}.")
            return

        if not SETTINGS.get("confirm_actions", True):
            self.launch_operation(action, item, command)
            return

        dialog = Gtk.AlertDialog()
        action_label = "Clone" if action == "install" and item.source == "git" and not item.installed else action.title()
        dialog.set_message(f"{action_label} {item.title()}?")
        dialog.set_detail(
            "This runs quietly in the background. If administrator access is "
            "needed, the desktop will show a graphical password prompt.\n\n"
            + shlex.join(command)
        )
        dialog.set_buttons(["Cancel", action_label])
        dialog.set_cancel_button(0)
        dialog.set_default_button(1)

        def finished(alert: Gtk.AlertDialog, result) -> None:
            try:
                response = alert.choose_finish(result)
            except GLib.Error:
                return
            if response == 1:
                self.launch_operation(action, item, command)

        dialog.choose(self.window, None, finished)

    def choose_pip_scope(self, item) -> None:
        if not self.window:
            return
        dialog = Gtk.AlertDialog()
        dialog.set_message(f"Install {item.title()} with Python Pip")
        dialog.set_detail(
            "Choose where Pip should place the package:\n\n"
            "• Managed venv: Isolated under ~/.local/share/pacmangr/pip-venvs\n"
            "• User install: Into ~/.local without touching system files\n"
            "• System install: Requires root privileges"
        )
        dialog.set_buttons(["Cancel", "Managed venv", "User install", "System install"])
        dialog.set_cancel_button(0)
        dialog.set_default_button(1)

        def finished(alert: Gtk.AlertDialog, result) -> None:
            try:
                response = alert.choose_finish(result)
            except GLib.Error:
                return
            scopes = {1: "venv", 2: "user", 3: "system"}
            scope = scopes.get(response)
            if scope:
                self.confirm_action("install", install_scope=scope)

        dialog.choose(self.window, None, finished)

    def launch_operation(self, action: str, item, command: list[str]) -> None:
        if self.operation_running:
            self.set_status("Another package operation is already running.")
            return
        try:
            argv = prepare_gui_operation(
                command,
                self.tools,
                action,
                shutil.which("pkexec"),
            )
        except RuntimeError as exc:
            self.set_status(str(exc))
            return

        self.operation_running = True
        self.install_button.set_sensitive(False)
        self.remove_button.set_sensitive(False)
        verb = "Installing" if action == "install" else "Removing"
        if self.package_activity:
            self.package_activity.start(action)
        self.start_operation_progress()
        self.set_status(f"{verb} {item.title()} in the background…", busy=True)

        def worker() -> None:
            env = os.environ.copy()
            env["DEBIAN_FRONTEND"] = "noninteractive"
            env["LC_ALL"] = "C"
            env.setdefault("TERM", "xterm-256color")
            try:
                code, output = run_streamed_operation(
                    argv,
                    env=env,
                    on_line=lambda line: GLib.idle_add(
                        self.update_operation_progress,
                        line,
                    ),
                )
            except OSError as exc:
                output = f"Could not start package operation: {exc}"
                code = 126
            GLib.idle_add(self.finish_operation, action, item, code, output)

        threading.Thread(target=worker, daemon=True).start()

    def finish_operation(self, action: str, item, code: int, output: str) -> bool:
        self.operation_running = False
        if self.package_activity:
            self.package_activity.stop()
        self.stop_operation_progress()
        text = output.strip() or f"The package manager exited with status {code}."
        self.detail_text.get_buffer().set_text(text)
        if code == 0:
            item.installed = action == "install"
            self.set_status(f"{action.title()} completed for {item.title()}.")
            # Refresh installed list if loaded
            if self.installed_loaded:
                self.load_installed(force=True)
        elif code in {126, 127} and "pkexec" in text:
            self.set_status("Graphical authentication is unavailable; package operation stopped.")
        else:
            last_line = text.splitlines()[-1]
            self.set_status(f"{action.title()} failed ({code}): {last_line}")

        if self.current_item is item:
            self.install_button.set_label("Reinstall" if item.installed else "Install")
            if item.source == "git":
                self.install_button.set_label("Update checkout" if item.installed else "Clone repository")
            self.install_button.set_sensitive(
                item.source != "appimage" and (item.source != "git" or bool(self.tools.git))
            )
            self.remove_button.set_sensitive((item.installed or item.source == "appimage") and item.source != "git")
            self.files_button.set_sensitive(item.installed)
        return False

    def on_open_tui(self, _button) -> None:
        preferred = SETTINGS.get("preferred_terminal", "auto")
        terminal = None
        if preferred != "auto":
            terminal = shutil.which(preferred)
        if not terminal:
            terminal = shutil.which("foot") or shutil.which("kitty") or shutil.which("alacritty") or shutil.which("xterm")
        pacmangr = shutil.which("pacmangr") or str(Path(__file__).resolve().with_name("pacmangr"))
        if not terminal:
            self.set_status("No terminal found.")
            return
        argv = (
            [terminal, "-a", "pacmangr-tui", "-T", "pacmangr", pacmangr]
            if Path(terminal).name == "foot"
            else [terminal, "-T", "pacmangr", "-e", pacmangr]
        )
        subprocess.Popen(argv, start_new_session=True)

    def do_shutdown(self) -> None:
        if self.package_activity:
            self.package_activity.stop()
        self.stop_operation_progress()
        Gtk.Application.do_shutdown(self)


if __name__ == "__main__":
    if len(sys.argv) > 1 and sys.argv[1] in {"-V", "--version"}:
        print(f"pacmangr-gui {CORE.VERSION}")
        raise SystemExit(0)
    raise SystemExit(PacmangrGUI().run(sys.argv))
