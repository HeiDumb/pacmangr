def load_core():
    script = Path(__file__).resolve().with_name("pacmangr")
    loader = importlib.machinery.SourceFileLoader("pacmangr_gui_core", str(script))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    if spec is None:
        raise RuntimeError(f"Could not load pacmangr backend from {script}")
    module = importlib.util.module_from_spec(spec)
    sys.modules[loader.name] = module
    loader.exec_module(module)
    return module


SETTINGS_PATH = Path.home() / ".config/pacmangr/gui_settings.json"
CURRENT_CSS_PROVIDER: Gtk.CssProvider | None = None


class SettingsManager:
    """Manages persistent user preferences for pacmangr-gui."""

    DEFAULTS = {
        "default_view": "browse",  # "browse" or "installed"
        "max_results": 250,
        "confirm_actions": True,
        "aur_helper": "auto",  # "auto", "yay", "paru", "disabled"
        "pip_scope": "venv",  # "venv", "user", "system"
        "preferred_terminal": "auto",
        "pacman_animation": True,
        "theme_accent": "auto",  # "auto", "gold", "cyan", "purple", "green", "coral"
        "compact_rows": False,
        "show_descriptions": True,
        "check_updates_on_launch": False,
        "sort_mode": "relevance",  # "relevance", "name", "source", "installed"
        "last_source": "all",
        "last_installed_source": "all",
        "window_width": 1180,
        "window_height": 760,
        "window_maximized": False,
    }

    def __init__(self, path: Path = SETTINGS_PATH) -> None:
        self.path = path
        self.data = dict(self.DEFAULTS)
        self.load()

    def load(self) -> None:
        if self.path.is_file():
            try:
                raw = json.loads(self.path.read_text(encoding="utf-8"))
                if isinstance(raw, dict):
                    self.data.update(raw)
            except Exception:
                pass

    def save(self) -> None:
        try:
            self.path.parent.mkdir(parents=True, exist_ok=True)
            self.path.write_text(json.dumps(self.data, indent=2), encoding="utf-8")
        except Exception:
            pass

    def get(self, key: str, default=None):
        return self.data.get(key, default if default is not None else self.DEFAULTS.get(key))

    def set(self, key: str, value) -> None:
        self.data[key] = value
        self.save()


